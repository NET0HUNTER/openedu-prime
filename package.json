{
  "name": "openedu-prime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "OpenEdu Prime — High-performance, metadata-driven multi-campus School ERP with full RBAC, live LMS, M-Pesa billing, timetable generation, and QWeb reporting.",
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,magenta \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.json --noEmit && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "seed:oshwal": "tsx server/cli/seed.ts oshwal",
    "seed:default": "tsx server/cli/seed.ts default",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "lucide-react": "^0.511.0",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
