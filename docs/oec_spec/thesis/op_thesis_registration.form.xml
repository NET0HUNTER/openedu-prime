<form string="Thesis Registration">
                    <header>
                        <button name="action_submit" string="Submit" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                        <button name="action_approve" string="Approve" type="object" invisible="state != 'submitted'" class="oe_highlight"/>
                        <button name="action_start" string="Start Research" type="object" invisible="state != 'approved'" class="oe_highlight"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state not in ['draft','submitted']"/>
                        <button name="action_submit_thesis" string="Submit Thesis" type="object" invisible="state != 'in_progress'" class="oe_highlight"/>
                        <button name="1276" string="Add Committee Member" type="action" context="{'default_registration_id': id}" class="btn-primary" invisible="state in ['completed', 'cancelled']"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_progress_reports" type="object" class="oe_stat_button" icon="fa-tasks" invisible="progress_count == 0">
                                <field name="progress_count" widget="statinfo" string="Progress Reports"/>
                            </button>
                            <button name="action_view_extensions" type="object" class="oe_stat_button" icon="fa-calendar-plus-o" invisible="extension_count == 0">
                                <field name="extension_count" widget="statinfo" string="Extensions"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="code" readonly="1"/>
                            </h1>
                            <label for="name" class="oe_edit_only"/>
                            <h2>
                                <field name="name" placeholder="Thesis Title"/>
                            </h2>
                        </div>
                        <group>
                            <group>
                                <field name="student_id" options="{'no_create': True}" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                                <field name="available_program_ids" invisible="1"/>
                                <field name="program_id" options="{'no_create': True}" readonly="state != 'draft'" domain="[('id', 'in', available_program_ids)]" on_change="1" can_create="True" can_write="True"/>
                                <field name="department_id" readonly="1"/>
                                <field name="research_area" readonly="state != 'draft'" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="registration_date" readonly="state != 'draft'" on_change="1"/>
                                <field name="program_duration_months" readonly="1"/>
                                <field name="default_submission_deadline" readonly="1"/>
                                <field name="final_submission_deadline" readonly="1" invisible="state == 'draft'" on_change="1"/>
                                <field name="has_supervisor" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Committee Members" name="committee">
                                <field name="committee_ids" on_change="1">
                                    <list editable="bottom">
                                        <field name="faculty_id" options="{'no_create': True}" on_change="1" can_create="True" can_write="True"/>
                                        <field name="role" on_change="1"/>
                                        <field name="email"/>
                                        <field name="phone"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Progress Reports" name="progress" invisible="state in ['draft', 'submitted']">
                                <field name="progress_report_ids" on_change="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="report_date"/>
                                        <field name="report_id"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Extension Requests" name="extensions">
                                <field name="extension_ids" on_change="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="request_date"/>
                                        <field name="current_deadline" on_change="1"/>
                                        <field name="requested_deadline" on_change="1"/>
                                        <field name="extension_duration"/>
                                        <field name="reason_id"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>