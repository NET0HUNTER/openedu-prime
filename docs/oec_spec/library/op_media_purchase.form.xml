<form string="Purchase Request">
                    <header>
                        <button name="act_requested" invisible="state != 'draft'" type="object" string="Request media" class="oe_highlight"/>
                        <button name="act_accept" invisible="state != 'request'" type="object" string="Accept" class="oe_highlight"/>
                        <button name="act_reject" invisible="state != 'request'" type="object" string="Reject"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,request,accept"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="True"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <group>
                            <group>
                                <field name="request_no"/>
                                <field name="name"/>
                                <field name="course_ids" can_create="True" can_write="True"/>
                                <field name="author"/>
                                <field name="requested_id" readonly="1"/>
                <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="media_type_id" can_create="True" can_write="True"/>
                                <field name="subject_ids" can_create="True" can_write="True"/>
                                <field name="publisher"/>
                                <field name="edition"/>
                                <field name="request_date"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>