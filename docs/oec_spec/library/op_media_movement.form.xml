<form string="media Movement">
                    <header>
                        <button name="issue_media" string="Issue media" type="object" class="oe_highlight" invisible="state not in ('available','reserve')"/>
                        <button name="1131" string="Return Media" type="action" context="{'default_media_id': media_id, 'default_media_unit_id': media_unit_id}" invisible="state != 'issue'" class="oe_highlight"/>
                    <button type="object" name="renew_media" string="Renew Media" invisible="state != 'issue'"/>
                        <field name="state" widget="statusbar" statusbar_visible="available,issue"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="True"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <group>
                            <group>
                                <field name="media_id" on_change="1" can_create="True" can_write="True"/>
                                <field name="media_type_id"/>
                            </group>
                            <group>
                                <field name="media_unit_id" domain="['&amp;',('media_id','=',media_id),('state','=','available')]" context="{'default_media_id': media_id}" on_change="1" can_create="True" can_write="True"/>
                    <field name="queue_count"/>
                            </group>
                        </group>
                        <group string="Student/Faculty Detail">
                            <group class="pt-3">
                                <field name="library_card_id" on_change="1" can_create="True" can_write="True"/>
                                <field name="student_id" readonly="1" force_save="1" required="type == 'student'" invisible="type != 'student'" context="{'form_view_ref':'openeducat_library.view_op_student_library_form'}"/>
                                <field name="faculty_id" readonly="1" force_save="1" required="type == 'faculty'" invisible="type != 'faculty'"/>
                            </group>
                            <group class="pt-3">
                                <field name="type" readonly="1" force_save="1"/>
                            </group>
                        </group>
                        <group>
                            <group class="pt-3">
                                <field name="issued_date" on_change="1"/>
                                <field name="actual_return_date"/>
                                <field name="invoice_id"/>
                            </group>
                            <group class="pt-3">
                                <field name="return_date"/>
                                <label for="penalty" string="Penalty"/>
                                <div class="row" name="penalty">
                                    <div class="col-5 col-sm-5 col-md-6 col-lg-4">
                                        <field name="penalty" widget="monetary"/>
                                    </div>
                                    <div class="col-7 col-sm-7 col-md-6 col-lg-8">
                                        <button name="create_penalty_invoice" string="Create Invoice" type="object" class="oe_highlight" invisible="state not in 'return' or invoice_id != False or penalty == 0"/>
                                    </div>
                                </div>
                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                        </group>
                    <group string="Renew Details" invisible="is_renew == False">
                        <field name="is_renew" invisible="1"/>
                        <field name="renew_ids" readonly="1" colspan="4" nolabel="1">
                            <list editable="top">
                                <field name="librarian_id"/>
                                <field name="renew_date"/>
                            </list>
                        </field>
                    </group>
                        <group col="4" string="Reservation Detail" invisible="1">
                            <field name="partner_id" can_create="True" can_write="True"/>
                            <field name="reserver_name"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>