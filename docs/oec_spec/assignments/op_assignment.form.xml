<form string="Assignment">
                    <header>

                        <button name="act_publish" invisible="state != 'draft'" type="object" string="Publish" class="oe_highlight"/>

                        <button name="act_set_to_draft" invisible="state not in ('publish', 'cancel')" type="object" string="Reset to Draft"/>
                        <!-- Reset from ``finish`` lives in
                             openeducat_grade_connector — that module owns
                             the marks trail and knows the confirm-dialog
                             wording. Base offers no reset from finish
                             because without grading there is no risk. -->


                        <button name="act_finish" class="oe_highlight" invisible="state != 'publish'" type="object" string="Finish"/>

                        <button name="act_cancel" invisible="state != 'publish'" type="object" string="Cancel"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,publish,finish"/>
                    <button name="update_mark" type="object" class="btn btn-primary" string="Update Grades" invisible="state != 'publish'"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="get_assignment_submissions" type="object" class="oe_stat_button" icon="fa-book" string="Submissions">
                                <field name="assignment_sub_line_count" widget="statinfo"/>
                            </button>
                        </div>
                        <field name="active" invisible="1"/>

                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <div>
                            <h1>

                                <field name="name" placeholder="Assignment Name" readonly="state !='draft'" style="width: 100%; font-size: 20px;" on_change="1"/>
                    <field name="sequence" style="font-size:20px;" on_change="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="courses_subjects" invisible="1" can_create="True" can_write="True"/>
                                <field name="course_id" readonly="state !='draft'" on_change="1" can_create="True" can_write="True"/>
                    <field name="year_id" required="1" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                                <field name="subject_id" readonly="state !='draft'" domain="[('id','in',courses_subjects)]" on_change="1" can_create="True" can_write="True"/>
                                <field name="assignment_type" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                <field name="grading_assignment_id" required="0" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="batch_id" context="{'course_id': course_id,'get_parent_batch':1}" readonly="state !='draft'" on_change="1" can_create="True" can_write="True"/>
                    <field name="term_id" required="1" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                                <field name="faculty_id" readonly="state !='draft'" domain="[('faculty_subject_ids','in',[subject_id])]" on_change="1" can_create="True" can_write="True"/>
                                <field name="reviewer" readonly="state !='draft'" can_create="True" can_write="True"/>
                    <field name="late_submission_id" can_create="True" can_write="True"/>
                    <field name="mark_update" invisible="1"/>
                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                        </group>
                        <notebook colspan="4">
                            <page name="basic_information" string="Basic Information">
                                <group>
                    <group>
                        <field name="attempt_type" readonly="state != 'draft'" on_change="1"/>
                    <field name="attempt" required="attempt_type == 'multiple'" invisible="attempt_type == 'single'" readonly="state != 'draft'"/>
                    </group>
                    <group>

                        <field name="max_attempt" readonly="state != 'draft'" invisible="attempt_type == 'single'"/>
                        <field name="grade" required="0" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                    </group>
                                    <group name="i_date">
                                        <field name="issued_date" readonly="state !='draft'" on_change="1"/>
                                        <field name="submission_date" readonly="state !='draft'" on_change="1"/>
                    <field name="evaluation_type" readonly="state != 'draft'"/>
                                        <field name="marks" required="0" invisible="1" readonly="state != 'draft'"/>
                </group>
                                </group>

                                <group id="mark" col="4" colspan="4" invisible="hide == True">
                    <field name="rubric_template_id" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                                    <field name="point" invisible="0" on_change="1"/>
                    <field name="points_validation_status" widget="badge" decoration-success="points_validation_status == 'valid'" decoration-danger="points_validation_status == 'invalid'" decoration-info="points_validation_status == 'no_template'"/>
                    <field name="final_assessment_attempt_criteria" widget="radio" readonly="state != 'draft'"/>
                    <field name="hide" invisible="1"/>
                                </group>
                                <label for="description" string="Description" class="mt32"/>
                                <field name="description" readonly="state !='draft'" colspan="4"/>
                            </page>
                            <page name="allocation_infomation" string="Student Allocation">
                                <field name="allocation_ids" domain="[('course_detail_ids.course_id','=',course_id),('course_detail_ids.batch_id','=',batch_id)]" colspan="4" nolabel="1" on_change="1" can_create="True" can_write="True">
                                    <list string="Allocation">
                                        <field name="title" on_change="1"/>
                                        <field name="name" on_change="1"/>
                                        <field name="email"/>
                                    </list>
                                </field>
                            </page>
                <page name="co_map" string="Outcome">
                    <field name="co_map_ids">
                        <list editable="bottom">
                            <field name="co_id" can_create="True" can_write="True"/>
                            <field name="weightage"/>
                        </list>
                    </field>
                </page>
                    <page name="additional_submission_configuration" string="Student Additional Attempt" invisible="attempt_type == 'single'">
                        <field name="additional_attempt">
                            <list>
                                <field name="assignment_id"/>
                                <field name="student_id"/>
                                <field name="datetime"/>
                                <field name="allowed_attempt"/>
                                <field name="create_by"/>
                            </list>
                        </field>
                    </page>
                <page name="missing_submissions" string="Missing Submissions" invisible="missing_student_count == 0">
                    <field name="is_submission_deadline_passed" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="is_submission_deadline_passed">
                        <field name="missing_student_count" readonly="1"/>
                        student(s) haven't submitted. The
                        deadline hasn't passed — Finish will
                        be blocked unless overridden by an
                        assignment manager.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not is_submission_deadline_passed">
                        Submission deadline has passed with
                        <field name="missing_student_count" readonly="1"/>
                        student(s) still missing.
                    </div>
                    <field name="missing_student_ids" nolabel="1" readonly="1">
                        <list string="Missing Submissions">
                            <field name="title" on_change="1"/>
                            <field name="name" on_change="1"/>
                            <field name="email"/>
                        </list>
                    </field>
                </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>