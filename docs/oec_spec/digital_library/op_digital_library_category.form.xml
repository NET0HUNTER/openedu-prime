<form>
                    <header/>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" on_change="1"/>
                                <field name="material_count"/>
                            </group>
                            <group>
                                <field name="parent_id" on_change="1" can_create="True" can_write="True"/>
                                <field name="company_id" optional="show" can_create="True" can_write="True"/>
                                <field name="display_name" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="material_ids" on_change="1" can_create="True" can_write="True"><list>
                    <field name="name"/>
                    <field name="material_type"/>
                    <field name="author_ids"/>
                    <field name="publisher_ids"/>
                    <field name="material_edition"/>
                    <field name="language_id"/>
                    <field name="company_id" optional="show"/>
                    <field name="isbn_code" optional="hide"/>
                    <field name="material_source" optional="hide"/>
                    <field name="publish_online" widget="boolean_toggle" optional="hide"/>
                    <field name="material_tags" widget="many2many_tags" optional="hide"/>
                </list></field>
                        </group>
                    </sheet>
                </form>