<list create="False" delete="False" edit="False">
                    <field name="material_id" on_change="1"/>
                    <field name="user_id"/>
                    <field name="enrollment_date"/>
                    <field name="state" string="Status" widget="badge" decoration-info="state in ('draft')" decoration-success="state in ('reading_list')" decoration-muted="state in ('in_progress')" optional="show"/>
                    <field name="category_ids" optional="hide" widget="many2many_tags"/>
                    <field name="last_access" optional="hide"/>
                    <field name="active" widget="boolean_toggle" optional="hide"/>
                    <field name="company_id" optional="show"/>
                </list>