<kanban class="o_kanban_mobile o_placement_kanban" sample="1">
                <field name="name"/>
                <field name="state"/>
                <field name="website_url"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="team_id"/>
                <field name="partner_id"/>
                <field name="is_favorite"/>
                <templates>
                    <t t-name="card">
                        <!-- State Ribbons -->
                        <widget name="web_ribbon" title="Draft" bg_color="bg-info text-white" invisible="state != 'draft'"/>
                        <widget name="web_ribbon" title="Confirmed" bg_color="bg-primary text-white" invisible="state != 'confirm'"/>
                        <widget name="web_ribbon" title="Published" bg_color="bg-success text-white" invisible="state != 'published'"/>
                        <widget name="web_ribbon" title="Unpublished" bg_color="bg-warning text-white" invisible="state != 'unpublished'"/>

                        <main class="d-flex flex-column gap-2 p-2 position-relative">
                            <!-- Header: Favorite + Title -->
                            <div class="d-flex align-items-center gap-1 pe-5">
                                <field name="is_favorite" widget="boolean_favorite" nolabel="1"/>
                                <h5 class="mb-0 fw-bold text-dark text-truncate flex-grow-1" style="font-size: 1.05rem; min-width: 0; line-height: 1.3;" t-att-title="record.name.value">
                                    <field name="name"/>
                                </h5>
                            </div>

                            <!-- Metadata -->
                            <div class="d-flex flex-column gap-1">
                                <div class="d-flex align-items-center small text-muted">
                                    <i class="fa fa-calendar me-2 flex-shrink-0" title="Dates"/>
                                    <span>
                                        <t t-esc="record.start_date.value"/>
                                        <i class="fa fa-long-arrow-right mx-1" title="to"/>
                                        <t t-esc="record.end_date.value"/>
                                    </span>
                                </div>
                                <div t-if="record.team_id.raw_value" class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-users me-2 flex-shrink-0" title="Team"/>
                                    <span class="text-truncate"><field name="team_id"/></span>
                                </div>
                                <div t-if="record.partner_id.raw_value" class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-building me-2 flex-shrink-0" title="Company"/>
                                    <span class="text-truncate"><field name="partner_id"/></span>
                                </div>
                            </div>

                            <!-- Footer: Design Link -->
                            <div class="d-flex gap-1 mt-auto pt-2 border-top">
                                <a t-attf-href="#{record.website_url.raw_value}" role="button" class="btn bg-light rounded text-decoration-none p-2 d-flex align-items-center justify-content-center flex-grow-1 text-muted border border-light-subtle" style="font-size: 12px; font-weight: 500; box-shadow: none; white-space: nowrap;">
                                    <i class="fa fa-external-link text-dark me-1 flex-shrink-0" style="font-size: 0.8125rem;" title="Design"/>
                                    <span class="text-truncate">Design</span>
                                </a>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>