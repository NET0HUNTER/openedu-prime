<kanban highlight_color="color" class="o_placement_kanban" sample="1">
                <field name="color"/>
                <field name="states"/>
                <field name="job_post"/>
                <field name="name"/>
                <field name="application_count"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="created_by"/>
                <templates>
                    <t t-name="menu">
                        <div role="menuitem" aria-haspopup="true">
                             <field name="color" widget="kanban_color_picker"/>
                        </div>
                    </t>
                    <t t-name="card">
                        <widget name="web_ribbon" title="Draft" bg_color="bg-info text-white" invisible="states != 'draft'"/>
                        <widget name="web_ribbon" title="Review" bg_color="bg-warning text-white" invisible="states != 'review'"/>
                        <widget name="web_ribbon" title="Published" bg_color="bg-success text-white" invisible="states != 'submit'"/>
                        <widget name="web_ribbon" title="Closed" bg_color="bg-secondary text-white" invisible="states != 'done'"/>
                        <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger text-white" invisible="states != 'cancel'"/>
                        <main class="d-flex flex-column gap-2 p-1">
                            <header class="d-flex align-items-center justify-content-between gap-2">
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <h5 class="fw-bold text-dark mb-0 text-truncate" style="font-size: 1.15rem; line-height: 1.3;" t-att-title="record.job_post.value">
                                        <t t-esc="record.job_post.value"/>
                                    </h5>
                                    <div class="text-muted small mt-1 d-flex align-items-center gap-1">
                                        <i class="fa fa-hashtag text-muted" title="Code" style="font-size: 0.75rem;"/>
                                        <span><t t-esc="record.name.value"/></span>
                                    </div>
                                </div>
                            </header>
                            
                            <!-- Meta info -->
                            <div class="d-flex flex-column gap-1 small text-muted">
                                <t t-if="record.start_date.raw_value">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-calendar text-muted" style="width: 14px; font-size: 0.85rem;" title="Period"/>
                                        <span>
                                            <t t-esc="record.start_date.value"/>
                                            <t t-if="record.end_date.raw_value">
                                                <span class="mx-1">→</span>
                                                <t t-esc="record.end_date.value"/>
                                            </t>
                                        </span>
                                    </div>
                                </t>
                                <t t-if="record.created_by.raw_value">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fa fa-user text-muted" style="width: 14px; font-size: 0.85rem;" title="Created by"/>
                                        <span>By <strong class="text-muted"><t t-esc="record.created_by.value"/></strong></span>
                                    </div>
                                </t>
                            </div>
                            
                            <!-- View Applications button at the bottom -->
                            <div class="d-flex mt-auto pt-2 border-top">
                                <a name="1203" type="action" role="button" class="btn btn-primary w-100 fw-bold py-2 text-center d-flex align-items-center justify-content-center gap-2" style="font-size: 0.95rem; border-radius: 6px; box-shadow: none;">
                                    <i class="fa fa-users" title="Applications"/>
                                    <span>View Applications</span>
                                </a>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>