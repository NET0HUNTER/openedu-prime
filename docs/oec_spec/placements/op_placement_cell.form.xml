<form string="Placement Cell Team">
                <header/>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="department_id" can_create="True" can_write="True"/>
                        </group>
                        <group>
                            <field name="user_id" can_create="True" can_write="True"/>
                            <field name="company_id" optional="show" can_create="True" can_write="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="members" string="Team Members">
                            <field name="member_ids" widget="many2many">
                                <list create="false">
                                    <field name="name" on_change="1"/>
                                    <field name="login" on_change="1"/>
                                    <field name="role_ids"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>