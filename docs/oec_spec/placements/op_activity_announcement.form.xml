<form string="Activity Announcement">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="set_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="set_published" string="Publish" type="object" class="oe_highlight" invisible="state in ['published','unpublished','draft']"/>
                    <button name="set_unpublished" string="Unpublish" type="object" invisible="state not in [ 'published']"/>
                    <button name="set_draft" string="Draft" type="object" invisible="state == 'draft'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_applications" type="object" icon="fa-users">
                            <field string="Applications" name="application_count" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <group>
                        <group>
                            <field name="seq"/>
                            <field name="name" readonly="state in ['confirm','published']"/>
                            <field name="job_post_id" widget="many2many_tags" readonly="state in ['confirm','published']" required="1" can_create="True" can_write="True"/>
                            <field name="team_id" readonly="state in ['confirm','published']" can_create="True" can_write="True"/>
                            <field name="process" readonly="state in ['confirm','published']" required="1"/>
                            <field name="opportunity_type" readonly="state in ['confirm','published']" required="1"/>
                            <field name="experience" readonly="state in ['confirm','published']" required="1"/>
                        </group>
                        <group>
                            <field name="partner_id" domain="[('is_company', '=', True)]" readonly="state in ['confirm','published']" required="1" can_create="True" can_write="True"/>
                            <field name="skill_id" widget="many2many_tags" readonly="state in ['confirm','published']" required="1" can_create="True" can_write="True"/>
                            <field name="season_id" readonly="state in ['confirm','published']" required="1" on_change="1" can_create="True" can_write="True"/>
                            <field name="start_date" readonly="state in ['confirm','published']"/>
                            <field name="end_date" readonly="state in ['confirm','published']"/>
                            <field name="written_test" readonly="state in ['confirm','published']"/>
                            <field name="group_discussion" readonly="state in ['confirm','published']"/>
                            <field name="company_id" optional="show" can_create="True" can_write="True"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" readonly="state in ['confirm','published']"/>
                    </group>
                </sheet>
                <chatter/>
            </form>