<kanban highlight_color="color" class="oe_background_grey o_kanban_dashboard o_placement_kanban" sample="1">
                <field name="name"/>
                <field name="user_id"/>
                <field name="department_id"/>
                <field name="member_ids"/>
                <field name="color"/>
                <templates>
                    <t t-name="menu">
                        <div class="container" role="menu">
                            <div class="row my-2">
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_view">
                                    <div role="menuitem" class="px-1">
                                        <div role="menuitem">
                                            <a t-if="widget.editable" name="edit_job" type="edit">Edit</a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_new">
                                    <div role="menuitem" class="px-1">
                                       <div t-if="widget.deletable">
                                            <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div t-if="widget.editable" class="o_kanban_card_manage_settings row">
                                <div role="menuitem" aria-haspopup="true" class="col-8">
                                    <field name="color" widget="kanban_color_picker"/>
                                </div>
                                <div role="menuitem" class="col-4">
                                    <a type="open">Settings</a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <main class="d-flex flex-column gap-2 p-2">
                            <!-- Card Header: Team Name -->
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-1">
                                <h5 class="mb-0 fw-bold text-primary text-truncate flex-grow-1" style="font-size: 1.05rem; min-width: 0;" t-att-title="record.name.value">
                                    <t t-esc="record.name.value"/>
                                </h5>
                            </div>

                            <!-- Metadata Rows -->
                            <div class="d-flex flex-column gap-1">
                                <div class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-user me-2 flex-shrink-0" title="Leader"/>
                                    <span class="text-truncate"><t t-esc="record.user_id.value"/></span>
                                </div>
                                <div t-if="record.department_id.raw_value" class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-building me-2 flex-shrink-0" title="Department"/>
                                    <span class="text-truncate"><t t-esc="record.department_id.value"/></span>
                                </div>
                                <div class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-users me-2 flex-shrink-0" title="Members"/>
                                    <span>Members: <span class="fw-semibold text-dark"><t t-esc="record.member_ids.raw_value ? record.member_ids.raw_value.length : 0"/></span></span>
                                </div>
                            </div>

                            <!-- Bottom: button slot -->
                            <div id="placement_cell_btn_area" class="d-flex mt-auto w-100 pt-2 border-top">
                <button class="btn btn-primary w-100 fw-bold py-2" name="1402" type="action">
                    View Opportunities
                </button></div>
                        </main>
                    </t>
                </templates>
            </kanban>