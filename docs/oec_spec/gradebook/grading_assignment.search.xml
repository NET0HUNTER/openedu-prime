                    <group>
                        <filter string="Year" name="group_by_year" domain="[]" context="{'grou p_by':'year_id'}"/>
                        <filter string="Term" name="group_by_term" domain="[]" context="{'group_by':'term_id'}"/>
                        <filter string="Course" name="group_by_course" domain="[]" context="{'group_by':'course_id'}"/>
                    </group>
                </search>
