<form string="Honor Roll">
                    <header>
                        <button name="generate_honor_roll" string="Generate Honor Roll" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_draft" invisible="state != 'cancel'" string="Draft" type="object" class="oe_highlight"/>
                        <button name="action_cancel" invisible="state != 'generate'" string="Cancel" type="object" class="oe_highlight"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <group>
                            <field name="name" string="Name"/>
                        </group>
                        <group class="mt32">
                            <group>
                                <field name="year_id" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="background" widget="image" class="oe_avatar" style="float: left;"/>
                            </group>
                            <group>
                                    <field name="course_id" can_create="True" can_write="True"/>
                                    <field name="from_per"/>
                                </group>
                                <group>
                                    <field name="subject_id" can_create="True" can_write="True"/>
                                    <field name="to_per"/>
                                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                                </group>
                        </group>
                        <group>
                            <field name="description" string="Description"/>
                        </group>
                        <group>
                            <field name="honor_line_id" readonly="1" string="Honor Line"><list>
                    <field name="student_id"/>
                    <field name="percentage"/>
                    <field name="year_id" optional="hide"/>
                    <field name="course_id" optional="hide"/>
                    <field name="honor_id" optional="hide"/>
                    <field name="subject_id" optional="hide"/>
                </list></field>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
