<form string="Grade Table">
                    <header/>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <group col="4" colspan="4">
                            <field name="name"/>
                            <field name="company_id" optional="show" can_create="True" can_write="True"/>
                        </group>
                        <group>
                            <field name="grade_table_ids"><list>
                    <field name="name"/>
                    <field name="percentage"/>
                    <field name="company_id" optional="show"/>
                </list></field>
                        </group>

                    </sheet>
                </form>
