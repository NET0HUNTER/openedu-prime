<kanban default_group_by="stage_id" class="o_slide_kanban o_grading_kanban" highlight_color="color" sample="1">
                    <field name="stage_id" on_change="1"/>
                    <field name="color"/>
                    <field name="state" on_change="1"/>
                    <field name="course_id"/>
                    <field name="subject_id"/>
                    <field name="faculty_id"/>
                    <field name="assignment_type" on_change="1"/>
                    <field name="issued_date"/>
                    <field name="point"/>
                    <field name="grade"/>
                    <field name="gradebook_line_id"/>
                    <templates>
                        <t t-name="menu">
                            <div class="container">
                                <div class="o_kanban_card_manage_settings row">
                                    <div role="menuitem" aria-haspopup="true" class="col-6">
                                        <field name="color" widget="kanban_color_picker"/>
                                    </div>
                                    <div class="col-12 ps-0">
                                        <div role="menuitem" class="w-100">
                                            <a class="dropdown-item mx-0" role="menuitem" type="open">View</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-name="card">
                            <main class="d-flex flex-column gap-2 p-1 position-relative">

                                <!-- Title -->
                                <h5 class="fw-bold text-dark mb-0 text-truncate" style="font-size: 1.2rem; line-height: 1.3;" t-att-title="record.name.value">
                                    <field name="name"/>
                                </h5>

                                <!-- Meta info -->
                                <div class="d-flex flex-column gap-1">
                                    <div t-if="record.course_id.raw_value" class="d-flex align-items-center text-truncate small text-muted">
                                        <i class="fa fa-graduation-cap me-2 text-muted" style="width: 14px;" title="Course"/>
                                        <span class="text-truncate"><field name="course_id"/></span>
                                    </div>
                                    <div t-if="record.subject_id.raw_value" class="d-flex align-items-center text-truncate small text-muted">
                                        <i class="fa fa-book me-2 text-muted" style="width: 14px;" title="Subject"/>
                                        <span class="text-truncate"><field name="subject_id"/></span>
                                    </div>
                                    <div t-if="record.gradebook_line_id.raw_value and record.gradebook_line_id.raw_value.length" class="d-flex align-items-center text-truncate small text-muted">
                                        <i class="fa fa-list me-2 text-muted" style="width: 14px;" title="Gradebook Entries"/>
                                        <span><t t-esc="record.gradebook_line_id.raw_value.length"/> Entries</span>
                                    </div>
                                </div>

                                <footer class="d-flex justify-content-between align-items-center mt-auto pt-1 border-top small text-muted" style="border-top: 1px solid #dee2e6;">
                                    <div t-if="record.issued_date.raw_value" class="d-flex align-items-center text-truncate small text-muted">
                                        <i class="fa fa-calendar me-1" title="Issued Date"/>
                                        <span><field name="issued_date"/></span>
                                    </div>
                                    <field name="activity_ids" widget="kanban_activity"/>
                                </footer>
                            </main>
                        </t>
                    </templates>
                </kanban>
