<list string="Employees" expand="context.get('expand', False)" multi_edit="1" duplicate="false" sample="1" js_class="hr_employee_list">
                    <header>
                        <button name="457" string="Launch Plan" type="action"/>
                    </header>
                    <field name="avatar_128" widget="image" options="{'size': [24, 24], 'img_class': 'rounded-3'}" width="30" nolabel="1"/>
                    <field name="name" readonly="1" on_change="1"/>
                    <field name="work_phone" class="o_force_ltr" readonly="1" optional="show" on_change="1"/>
                    <field name="work_email" optional="hide"/>
            <field name="thursday_location_id" readonly="0" string="Work Location" optional="hide"/>
                    <field name="hr_presence_state" string="Presence" optional="hide"/>
                    <field name="contract_date_start" optional="hide" on_change="1"/>
                    <field name="contract_date_end" optional="hide" on_change="1"/>
                    <field name="currency_id" column_invisible="1"/>
                    <field name="wage" widget="monetary" optional="hide" on_change="1"/>
                    <field name="employee_type" optional="hide" on_change="1"/>
                    <field name="contract_type_id" optional="hide" on_change="1" can_create="True" can_write="True"/>
                    <field name="structure_type_id" optional="hide" on_change="1" can_create="True" can_write="True"/>
                    <field name="activity_ids" widget="list_activity" optional="hide" on_change="1"/>
                    <field name="activity_user_id" optional="hide" string="Activity by" widget="many2one_avatar_user"/>
                    <field name="activity_date_deadline" widget="remaining_days" optional="hide"/>
                    <field name="company_id" readonly="1" optional="hide" on_change="1"/>
                    <field name="department_id" optional="show" on_change="1" can_create="True" can_write="True"/>
                    <field name="job_id" context="{'default_no_of_recruitment': 0, 'default_is_favorite': False}" optional="show" on_change="1" can_create="True" can_write="True"/>
                    <field name="parent_id" widget="many2one_avatar_employee" optional="show" on_change="1" can_create="True" can_write="True"/>
                    <field name="address_id" column_invisible="True" on_change="1" can_create="True" can_write="True"/>
                    <field name="company_id" column_invisible="True" on_change="1" can_create="True" can_write="True"/>
                    <field name="birthday" optional="hide"/>
                    <field name="work_location_id" optional="hide" column_invisible="1" on_change="1" can_create="True" can_write="True"/>
                <field name="resource_calendar_id" optional="hide" on_change="1" can_create="True" can_write="True"/>
                <field name="resource_id" optional="hide" on_change="1" can_create="True" can_write="True"/>
                <field name="leave_manager_id" optional="hide" widget="many2one_avatar_user" can_create="True" can_write="True"/>
                    <field name="expense_manager_id" placeholder="Auto-validation" optional="hide" widget="many2one_avatar_user" can_create="True" can_write="True"/>
                    <field name="coach_id" widget="many2one_avatar_employee" optional="hide" can_create="True" can_write="True"/>
                    <field name="user_id" string="Related User" widget="many2one_avatar_user" optional="hide" on_change="1" can_create="True" can_write="True"/>
                    <field name="active" column_invisible="True" on_change="1"/>
                    <field name="category_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide" can_create="True" can_write="True"/>
                    <field name="country_id" optional="hide" on_change="1" can_create="True" can_write="True"/>
                </list>