<list string="Expenses" multi_edit="1" sample="1" js_class="hr_expense_tree" decoration-info="state == 'draft'">
                    <field name="is_editable" column_invisible="True"/>
                    <field name="company_id" column_invisible="True" on_change="1"/>
                    <field name="company_currency_id" column_invisible="True" on_change="1"/>
                    <field name="nb_attachment" column_invisible="True"/>
                    <field name="is_multiple_currency" column_invisible="True" on_change="1"/>
                    <field name="product_has_cost" column_invisible="True" on_change="1"/>
                    <field name="selectable_payment_method_line_ids" column_invisible="True" on_change="1"/>

                    <!--  Always Shown start -->
                    <field name="employee_id" widget="many2one_avatar_employee" readonly="not is_editable" on_change="1" can_create="True" can_write="True"/>
                    <field name="name" readonly="not is_editable"/>

                    <!--  Optional -->
                    <field name="department_id" optional="hide" readonly="True"/>
                    <field name="date" optional="show" readonly="not is_editable" on_change="1"/>
                    <field name="product_id" optional="show" readonly="not is_editable" required="1" on_change="1" can_create="True" can_write="True"/>
                    <field name="payment_mode" optional="show" readonly="not is_editable"/>
                    <field name="activity_ids" widget="list_activity" optional="show"/>
                    
                    <field name="account_id" optional="hide" readonly="not is_editable" on_change="1" can_create="True" can_write="True"/>
                    <field name="journal_id" optional="hide" readonly="True"/>
                    <field name="payment_method_line_id" optional="hide" readonly="not is_editable" on_change="1" can_create="True" can_write="True"/>
                    <field name="manager_id" optional="hide" readonly="not is_editable" on_change="1"/>
                    <field name="company_id" optional="show" readonly="True" on_change="1"/>
                    <field name="price_unit" string="Unit Price" optional="hide" widget="monetary" options="{'currency_field': 'company_currency_id', 'field_digits': True}" readonly="True" on_change="1"/>
                    <field name="quantity" optional="hide" readonly="not is_editable or not product_has_cost" on_change="1"/>
                    <field name="tax_ids" optional="hide" widget="many2many_tax_tags" readonly="not is_editable or not product_has_cost" on_change="1" can_create="True" can_write="True"/>
                    <field name="tax_amount" sum="Total Taxes" readonly="True" optional="hide"/>
                    <field name="nb_attachment" widget="nb_attachment" nolabel="1" readonly="True"/>
                    <field name="total_amount" sum="Total Amount" widget="monetary" readonly="not is_editable or product_has_cost" options="{'currency_field': 'company_currency_id'}" decoration-bf="1" on_change="1"/>
                    
                    
                    <!--  Always Shown end -->
                    <field name="state" optional="show" readonly="True" decoration-info="state == 'draft'" decoration-success="state in ['approved', 'posted', 'in_payment', 'paid']" decoration-warning="state == 'submitted'" decoration-danger="state == 'refused'" widget="badge" on_change="1"/>
                </list>