<form string="Contract logs">
                <field name="company_id" invisible="1" on_change="1" can_create="True" can_write="True"/>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group string="Information" col="2">
                        <group col="1">
                            <field name="ins_ref"/>
                            <field name="cost_subtype_id" on_change="1" can_create="True" can_write="True"/>
                            <field name="insurer_id" widget="many2one_avatar" can_create="True" can_write="True"/>
                            <field name="service_ids" widget="many2many_tags" can_create="True" can_write="True"/>
                            <field name="company_id" placeholder="Visible to all" on_change="1" can_create="True" can_write="True"/>
                        </group>
                        <group col="2">
                            <field name="start_date"/>
                            <field name="expiration_date" required="cost_frequency != 'no'"/>
                            <field name="user_id" widget="many2one_avatar_user" can_create="True" can_write="True"/>
                            <field name="purchaser_id" invisible="1"/>
                <field name="purchaser_employee_id" string="Driver" invisible="1"/>
                        </group>
                    </group>
                    <group string="Vehicle" col="2">
                        <group col="1">
                            <field name="vehicle_id" on_change="1" can_create="True" can_write="True"/>
                        </group>
                        <group col="2">
                            <field name="purchaser_id" widget="many2one_avatar"/>
                        </group>
                    </group>
                    <group string="Cost" col="2">
                        <group>
                            <field name="amount" string="Activation Cost" help="Cost that is paid only once at the creation of the contract" widget="monetary" class="w-25"/>
                            <label for="cost_generated"/>
                            <div class="o_row">
                                <span class="w-25">
                                    <field name="cost_generated" invisible="cost_frequency == 'no'" widget="monetary"/>
                                </span>
                                <field name="cost_frequency"/>
                            </div>
                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                    </group>
                    <separator string="Terms and Conditions"/>
                    <field name="notes" nolabel="1" placeholder="Write here all other information relative to this contract"/>
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_employee" type="object" class="oe_stat_button" icon="fa-id-card-o" invisible="not purchaser_employee_id">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Employee</span>
                            <span class="o_stat_value"><field name="purchaser_employee_id"/></span>
                        </div>
                    </button>
                </div>
                </sheet>
                <chatter/>
            </form>