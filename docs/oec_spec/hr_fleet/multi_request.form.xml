<form>
                    <header>
                        <field name="user_status" invisible="1"/>
                        <button name="action_confirm" string="Submit" type="object" invisible="request_status != 'new'" class="btn-primary"/>
                        <button name="action_approve" string="Approve" type="object" invisible="request_status != 'pending'" class="btn-primary"/>
                        <button name="action_refuse" string="Refuse" type="object" invisible="request_status != 'pending'"/>
                        <button name="action_draft" string="Back To Draft" type="object" invisible="request_status != 'cancel'"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="request_status in ['new','cancel']"/>
                        <widget name="attach_document" string="Attach Document" action="message_post" invisible="attachment_number &lt; 1"/>
                        <widget name="attach_document" string="Attach Receipt" action="message_post" highlight="1" invisible="attachment_number &gt;= 1 or id == False"/>
                        <field name="request_status" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="o_not_full oe_button_box">
                            <button name="action_get_attachment_view" class="oe_stat_button" icon="fa-book" type="object" invisible="attachment_number == 0">
                                <field name="attachment_number" widget="statinfo" string="Documents" options="{'reload_on_button': true}"/>
                            </button>
                        </div>
                        <field name="document_opt" invisible="1"/>
                        <field name="partner_opt" invisible="1"/>
                        <field name="date_opt" invisible="1"/>
                        <field name="period_opt" invisible="1"/>
                        <field name="product_opt" invisible="1"/>
                        <field name="quantity_opt" invisible="1"/>
                        <field name="amount_opt" invisible="1"/>
                        <field name="payment_opt" invisible="1"/>
                        <field name="reference_opt" invisible="1"/>
                        <field name="location_opt" invisible="1"/>

                        <div class="oe_title">
                            <label for="name" string="Approval Request"/>
                            <h1>
                                <field name="name" placeholder="E.g: Expenses Paris business trip" readonly="request_status != 'new'"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id" readonly="request_status != 'new'" can_create="True" can_write="True"/>
                                <field name="approval_type_id" readonly="request_status != 'new'" can_create="True" can_write="True"/>
                                <field name="date_confirmed" readonly="1"/>
                                <label for="date" string="Date" invisible="date_opt == 'none'" readonly="request_status != 'new'"/>
                                <div invisible="date_opt == 'none'" readonly="request_status != 'new'">
                                    <div>
                                        <field name="date" class="oe_inline" required="date_opt == 'required'" readonly="request_status != 'new'"/>
                                    </div>
                                </div>
                                <label for="date_start" string="Period" invisible="period_opt == 'none'" readonly="request_status != 'new'"/>
                                <div invisible="period_opt == 'none'" readonly="request_status != 'new'">
                                    <div>
                                        <span>From:</span>
                                        <field name="date_start" class="oe_inline" required="period_opt == 'required'" readonly="request_status != 'new'"/>
                                    </div>
                                    <div>
                                        <span>to:</span>
                                        <field name="date_end" class="oe_inline ml-4" required="period_opt == 'required'" readonly="request_status != 'new'"/>
                                    </div>
                                </div>
                                <field name="location" invisible="location_opt == 'none'" required="location_opt == 'required'" readonly="request_status != 'new'" placeholder="e.g. Brussels"/>
                                <field name="partner_id" invisible="partner_opt == 'none'" required="partner_opt == 'required'" readonly="request_status != 'new'" can_create="True" can_write="True"/>
                                <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                            <group name="request_details">
                                <field name="quantity" invisible="quantity_opt == 'none' or product_opt != 'none'" required="quantity_opt == 'required' or product_opt == 'none'" readonly="request_status != 'new'"/>
                                <field name="amount" invisible="amount_opt == 'none'" required="amount_opt == 'required'" readonly="request_status != 'new'"/>
                                <field name="reference" invisible="reference_opt == 'none'" required="reference_opt == 'required'" readonly="request_status != 'new'"/>
                                <field name="source_document" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Products" name="products" invisible="product_opt == 'none'" readonly="request_status != 'new'">
                                <field name="product_line_ids" context="{'tree_view_ref': 'multi_approval.multi_approval_product_line_view_tree'}" readonly="request_status != 'new'"><list editable="bottom">
                    <field name="product_id" on_change="1" can_create="True" can_write="True"/>
                    <field name="quantity"/>
                    <field name="product_uom_id"/>
                </list></field>
                            </page>
                            <page string="Description" name="reason">
                                <field name="reason" readonly="request_status not in ('new', 'pending')"/>
                            </page>
                            <page string="Approver(s)">
                                <field name="line_ids" readonly="request_status != 'new'">
                                    <list editable="bottom" decoration-success="status=='approved'" decoration-warning="status=='pending'" decoration-danger="status=='refused'">
                                        <field name="user_id" can_create="True" can_write="True"/>
                                        <field name="require_opt"/>
                                        <field name="status"/>
                                        <field name="approve_tmpl_id" can_create="True" can_write="True"/>
                                        <field name="reject_tmpl_id" can_create="True" can_write="True"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>