<list string="Time Off Type" multi_edit="1">
                <field name="sequence" widget="handle"/>
                <field name="display_name"/>
                <field name="request_unit" optional="hide" on_change="1"/>
                <field name="leave_validation_type" optional="hide" string="Time Off Approval"/>
                <field name="responsible_ids" widget="many2many_tags" invisible="leave_validation_type in ['no_validation', 'manager'] and (not requires_allocation or allocation_validation_type != 'hr')" optional="hide" can_create="True" can_write="True"/>
                <field name="requires_allocation" optional="hide" on_change="1"/>
                <field name="allocation_validation_type" string="Allocation Approval"/>
                <field name="employee_requests" optional="hide"/>
                <field name="color" widget="color_picker" optional="hide"/>
                <field name="company_id" optional="show" readonly="is_used" on_change="1" can_create="True" can_write="True"/>
                <field name="country_id" optional="show" readonly="company_id or is_used"/>
            <field name="is_used" column_invisible="True" readonly="True" data-used-by="readonly='company_id or is_used' (field,country_id)"/>
</list>