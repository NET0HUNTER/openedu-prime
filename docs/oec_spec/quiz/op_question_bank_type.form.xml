<form string="Question Bank Type">
                <header/>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="company_id" optional="show" can_create="True" can_write="True"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Description..." nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>