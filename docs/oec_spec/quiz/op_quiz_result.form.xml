<form string="Results">
                <header>
                    <button string="Submit" class="oe_highlight" invisible="state != 'open'" type="object" name="get_action_submit"/>
                    <button string="To Asses" class="oe_highlight" invisible="state != 'submit'" type="object" name="get_action_asses"/>
                    <button string="Done" class="oe_highlight" invisible="state != 'asses'" type="object" name="get_action_done"/>
                    <field name="state" widget="statusbar" status_visible="open,hold,submit,assets,done"/>
                    <button name="1249" string="Override Marks" type="action" invisible="state != 'open' or state != 'done'" class="oe_highlight"/>
                    <button string="ReOpen" class="oe_highlight" invisible="state != 'hold'" type="object" name="get_action_re_open"/>
                </header>
                <sheet>
                    <group col="2">
                        <group>
                            <field name="index"/>
                            <field name="name" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="quiz_id" readonly="1" on_change="1"/>
                            <field name="categ_id" readonly="1"/>
                        </group>
                    </group>
                    <group col="2">
                        <group>
                            <field name="total_marks" readonly="1"/>
                            <field name="received_marks" readonly="1"/>
                            <field name="score" readonly="1" widget="float" options="{&quot;precision&quot;: 2}"/>
                            <field name="submit_date" readonly="1"/>
                            <field name="company_id" optional="show" can_create="True" can_write="True"/>
                        </group>
                        <group>
                            <field name="total_question" readonly="1"/>
                            <field name="total_correct" readonly="1"/>
                            <field name="total_incorrect" readonly="1"/>
                            <field name="finish_date" readonly="1"/>
                        </group>
                    </group>
                    <group name="result" string="Result">
                        <field name="line_ids" nolabel="1" readonly="state in ['done','cancel']" colspan="2" on_change="1">
                            <list>
                                <field name="display_type" column_invisible="1"/>
                                <field name="sequence" column_invisible="1" widget="handle"/>
                                <field name="name" on_change="1"/>
                                <field invisible="display_type != False" name="answer" widget="html" on_change="1"/>
                                <field invisible="display_type != False" name="given_answer" widget="html" on_change="1"/>
                                <field invisible="display_type != False" name="question_mark"/>
                                <field name="line_ids" optional="hide" on_change="1"/>
                                <field invisible="display_type != False" name="mark" on_change="1"/>
                                <field invisible="display_type != False" name="que_type"/>
                                <field invisible="display_type != False" name="case_sensitive" widget="boolean_toggle" optional="hide"/>
                                <field invisible="display_type != False" name="result_id" optional="hide" on_change="1"/>
                                <field invisible="display_type != False" name="line_ids" optional="hide" on_change="1"/>
                                <field invisible="display_type != False" name="bank_line" optional="hide"/>
                                <field invisible="display_type != False" name="company_id" optional="show"/>
                                <button name="1248" string="Update Mark" type="action" context="{'default_name':name,'default_answer':given_answer}" invisible="que_type != 'descriptive'" class="oe_highlight"/>
                            </list>
                            <form string="Results">
                                <field name="display_type" invisible="1"/>
                                <group invisible="display_type != 'section'">
                                    <field name="name" string="Section" readonly="1" on_change="1"/>
                                </group>
                                <group invisible="display_type != False">
                                    <field name="name" readonly="1" on_change="1"/>
                                    <field name="answer" readonly="1" on_change="1"/>
                                    <field name="given_answer" readonly="1" on_change="1"/>
                                    <field name="question_mark" readonly="1"/>
                                    <field name="reference_material" readonly="1"/>
                                    <field name="following_line_ids" readonly="1" invisible="que_type != 'match_following'">
                                        <list>
                                            <field name="question"/>
                                            <field name="image" widget="image" class="oe_avatar float-start"/>
                                            <field name="name" on_change="1"/>
                                            <field name="default_answer"/>
                                        </list>
                                    </field>
                                    <field name="following_images_line_ids" readonly="1" invisible="que_type != 'match_following_images'" on_change="1">
                                        <list>
                                            <field name="image" widget="image" class="oe_avatar float-start"/>
                                            <field name="default_answer" widget="image" class="oe_avatar float-start"/>
                                            <field name="given_answer" widget="image" class="oe_avatar float-start" on_change="1"/>
                                            <field name="grade_id" optional="hide"/>
                                            <field name="following_images_line_id" optional="hide" on_change="1"/>
                                            <field name="company_id" optional="show"/>
                                        </list>
                                    </field>
                                    <field name="multiple_choice_que_type" invisible="que_type != 'multiple_choice'"/>
                                    <field name="multiple_choice_line_ids" readonly="1" invisible="que_type != 'multiple_choice'" on_change="1">
                                        <list>
                                            <field name="que_text" attrs="{'column_invisible': [('parent.multiple_choice_que_type', '=', 'image')]}"/>
                                            <field name="que_image" widget="image" column_invisible="parent.multiple_choice_que_type == 'text'"/>
                                            <field name="default_answer"/>
                                            <field name="given_answer" on_change="1"/>
                                            <field name="company_id" optional="show"/>
                                        </list>
                                    </field>
                                    <field name="sort_paragraphs_line_ids" invisible="que_type != 'sort_paragraphs'" on_change="1">
                                        <list>
                                            <field name="given_answer" on_change="1"/>
                                            <field name="default_answer"/>
                                        </list>
                                    </field>
                                    <field name="mark" on_change="1"/>
                                    <field name="que_type" readonly="1"/>
                                    <field name="case_sensitive" invisible="que_type != 'blank'"/>
                                    <field name="grade_true_id" invisible="que_type != 'blank'" can_create="True" can_write="True"/>
                                    <field name="grade_false_id" invisible="que_type != 'blank'" can_create="True" can_write="True"/>
                                    <field name="bank_line" can_create="True" can_write="True"/>
                                </group>
                            </form>
                        </field>
                    </group>
                    <group name="warning" string="Warning">
                            <field name="warning_line_ids" nolabel="1" colspan="2">
                                <list>
                                    <field name="warning_no" readonly="1" width="130"/>
                                    <field name="warning_name" readonly="1" width="480px"/>
                                    <field name="time" readonly="1" width="200px"/>
                                    <field name="warning_attachment" widget="image" height="20" width="40" class="oe_avatar"/>
                                    <field name="result_id" optional="hide"/>
                                </list>
                            </field>
                    </group>
                </sheet>
                <chatter/>
            </form>