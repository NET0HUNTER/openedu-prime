<form string="Question Bank">
                <header/>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <group col="4" colspan="4">
                        <field name="name" required="1"/>
                        <field name="bank_type_id" required="1" can_create="True" can_write="True"/>
                        <field name="company_id" optional="show" can_create="True" can_write="True"/>
                    </group>
                    <notebook colspan="2">
                        <page string="Questions">
                            <field name="line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="que_type"/>
                                    <field name="mark"/>
                                    <field name="case_sensitive" widget="boolean_toggle" optional="hide"/>
                                    <field name="answer" optional="hide"/>
                                    <field name="line_ids" optional="hide"/>
                                    <field name="material_type" optional="hide"/>
                                    <field name="document_id" optional="hide"/>
                                    <field name="company_id" optional="show"/>
                                </list>
                                <form string="Questions">
                                    <group>
                                        <field name="name" required="1"/>
                                        <field name="mark" required="1"/>
                                        <field name="que_type" required="1"/>
                                        <field name="case_sensitive" invisible="que_type not in ['blank']"/>
                                        <field name="answer" invisible="que_type not in ['blank', 'descriptive','numeric']"/>
                                        <field name="multiple_choice_que_type" invisible="que_type != 'multiple_choice'" required="que_type == 'multiple_choice'"/>
                                        <field name="grade_true_id" invisible="que_type in ['descriptive','optional']" required="1" can_create="True" can_write="True"/>
                                        <field name="grade_false_id" invisible="que_type in ['descriptive','optional']" required="1" can_create="True" can_write="True"/>
                                        <field name="material_type"/>
                                        <field name="video_type" invisible="material_type not in ['video']" required="material_type in ['video']"/>
                                        <field name="datas" widget="binary" invisible="(material_type in ['quiz'] and video_type in ['fileupload']) or ((material_type not in ['audio','document','infographic'] and video_type in ['youtube','vimeo','dartfish']) and video_type not in ['fileupload'])"/>
                                        <field name="url" invisible="material_type != 'video' or video_type == 'fileupload'" on_change="1"/>
                                        <field name="document_id" invisible="material_type != 'video' or video_type == 'fileupload'"/>

                                    </group>
                                    <notebook colspan="4">
                                        <page string="Answers">
                                            <field name="line_ids" invisible="que_type != 'optional'">
                                                <list editable="bottom">
                                                    <field name="name"/>
                                                    <field name="grade_id" required="1" options="{'no_create': True}" can_create="True" can_write="True"/>
                                                    <field name="question_id" optional="hide" can_create="True" can_write="True"/>
                                                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                                                </list>
                                                <form string="Answers">
                                                    <group>
                                                        <field name="name"/>
                                                        <field name="grade_id" options="{'no_create': True}" can_create="True" can_write="True"/>
                                                    </group>
                                                </form>
                                            </field>
                                            <field name="following_line_ids" invisible="que_type != 'match_following'">
                                                <list editable="bottom">
                                                    <field name="image" widget="image" class="oe_avatar float-start" required="1"/>
                                                    <field name="question" required="1"/>
                                                    <field name="answer" required="1"/>
                                                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                                                </list>
                                                <form string="Answers">
                                                    <group>
                                                        <field name="image" widget="image" class="oe_avatar float-start" required="1"/>
                                                        <field name="question" required="1"/>
                                                        <field name="answer" required="1"/>
                                                    </group>
                                                </form>
                                            </field>
                                            <field name="following_images_line_ids" invisible="que_type != 'match_following_images'">
                                                <list editable="bottom">
                                                    <field name="image" widget="image" class="oe_avatar float-start" required="1"/>
                                                    <field name="default_answer" string="Default Answer" widget="image" class="oe_avatar float-start" required="1"/>
                                                    <field name="given_answer" optional="hide"/>
                                                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                                                </list>
                                                <form string="Answers">
                                                    <group>
                                                        <field name="image" widget="image" class="oe_avatar float-start" required="1"/>
                                                        <field name="default_answer" required="1"/>
                                                    </group>
                                                </form>
                                            </field>
                                            <field name="multiple_choice_line_ids" invisible="que_type != 'multiple_choice'">
                                                <list editable="bottom">
                                                    <field name="que_text" column_invisible="parent.multiple_choice_que_type == 'image'"/>
                                                    <field name="que_image" widget="image" class="oe_avatar float-start" column_invisible="parent.multiple_choice_que_type == 'text'"/>
                                                    <field name="default_answer"/>
                                                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                                                </list>
                                                <form string="Answers">
                                                    <group>
                                                        <field name="que_text" column_invisible="parent.multiple_choice_que_type == 'image'"/>
                                                        <field name="que_image" widget="image" class="oe_avatar float-start" column_invisible="parent.multiple_choice_que_type == 'text'"/>
                                                        <field name="default_answer"/>
                                                    </group>
                                                </form>
                                            </field>
                                            <field name="sort_paragraphs_line_ids" invisible="que_type != 'sort_paragraphs'">
                                                <list editable="bottom">
                                                    <field name="question"/>
                                                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                                                </list>
                                                <form string="Answers">
                                                    <group>
                                                        <field name="question"/>
                                                    </group>
                                                </form>
                                            </field>
                                        </page>
                                    </notebook>
                                </form>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description" placeholder="Description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>