<search string="Attendance Line">
                    <field name="attendance_id"/>
                    <field name="student_id"/>
                    <field name="present"/>
                    <filter string="Present" name="group_by_attendance_present" domain="[('present', '=', True)]"/>
                    <filter string="Absent" name="group_by_attendance_absent" domain="[('present', '=', False)]"/>
                    <filter string="Today" name="group_by_attendance_today" domain="[('attendance_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Attendance" name="group_by_attendance" domain="[]" context="{'group_by':'attendance_id'}"/>
                        <filter string="Course" name="group_by_attendance_course" domain="[]" context="{'group_by':'course_id'}"/>
                        <filter string="Batch" name="group_by_attendance_batch" domain="[]" context="{'group_by':'batch_id'}"/>
                        <filter string="Student" name="group_by_attendance_student" domain="[]" context="{'group_by':'student_id'}"/>
                        <filter string="Present ?" name="group_by_attendance_present" domain="[]" context="{'group_by':'present'}"/>
                        <filter string="Date" name="group_by_attendance_date" domain="[]" context="{'group_by':'attendance_date'}"/>
                    </group>
                </search>
