<kanban highlight_color="color" string="Attendance Sheet kanban" class="o_slide_kanban o_slide_channel_kanban o_attendance_kanban" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="color"/>
                <field name="state"/>
                <field name="attendance_date"/>
                <field name="batch_id"/>
                <field name="course_id"/>
                <field name="faculty_id"/>
                <templates>
                    <t t-name="menu">
                        <div class="container" role="menu">
                            <div class="row my-2">
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_view">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_views" class="o_kanban_card_manage_title">
                                            <span>Views</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_new">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_new" class="o_kanban_card_manage_title">
                                            <span>New</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_operations">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_reports" class="o_kanban_card_manage_title">
                                            <span>Reports</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div t-if="widget.editable" class="o_kanban_card_manage_settings row">
                                <div role="menuitem" aria-haspopup="true" class="col-8">
                                    <field name="color" widget="kanban_color_picker"/>
                                </div>
                                <div role="menuitem" class="col-4">
                                    <a type="open">Settings</a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <widget name="web_ribbon" title="Draft" bg_color="bg-info text-white" invisible="state != 'draft'"/>
                        <widget name="web_ribbon" title="In Progress" bg_color="bg-warning text-white" invisible="state != 'start'"/>
                        <widget name="web_ribbon" title="Done" bg_color="bg-success text-white" invisible="state != 'done'"/>
                        <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger text-white" invisible="state != 'cancel'"/>
                        
                        <main class="d-flex flex-column gap-2 p-1 position-relative h-100">
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start gap-2" style="padding-right: 85px;">
                                <div class="d-flex align-items-center gap-3 w-100" style="min-width: 0;">
                                    <div class="d-flex flex-column gap-1 min-w-0">
                                        <h5 class="mb-0 fw-bold text-truncate" t-att-title="record.name.value" style="font-size: 1.15rem;">
                                            <field name="name"/>
                                        </h5>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-flex flex-column gap-1 mb-1 mt-1 px-1">
                                <div t-if="record.attendance_date.raw_value" class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-calendar me-2" role="img" aria-label="Attendance Date" title="Attendance Date"/>
                                    <field name="attendance_date"/>
                                </div>
                                <div t-if="record.course_id.raw_value" class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-book me-2" role="img" aria-label="Course" title="Course"/>
                                    <field name="course_id"/>
                                </div>
                                <div t-if="record.batch_id.raw_value" class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-users me-2" role="img" aria-label="Batch" title="Batch"/>
                                    <field name="batch_id"/>
                                </div>
                                <div t-if="record.faculty_id.raw_value" class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-user me-2" role="img" aria-label="Faculty" title="Faculty"/>
                                    <field name="faculty_id"/>
                                </div>
                            </div>
                            
                            <div class="d-flex gap-2 flex-wrap mt-auto pt-2 border-top">
                                <button name="action_sheet_view" type="object" class="btn btn-sm btn-outline-primary flex-grow-1 fw-semibold">
                                    <i class="fa fa-eye me-1" role="img" aria-label="View" title="View"/>View
                                </button>
                                <button type="object" name="attendance_start" invisible="state != 'draft'" class="btn btn-sm btn-outline-success flex-grow-1 fw-bold">
                                    <i class="fa fa-play me-1" role="img" aria-label="Start" title="Start"/>Start
                                </button>
                                <button type="object" name="reset_attendance" invisible="state != 'start'" class="btn btn-sm btn-outline-secondary flex-grow-1 fw-semibold">
                                    <i class="fa fa-undo me-1" role="img" aria-label="Reset" title="Reset"/>Reset
                                </button>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
