<form string="Attendance Type">
                    <header/>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <group>
                            <group col="4" colspan="4">
                                <field name="name"/>
                                <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                            <group col="4" string="Student Should Be Marked As" name="student_marked_As">
                                <field name="present"/>
                                <field name="absent"/>
                                <field name="excused"/>
                                <field name="late"/>
                            </group>
                        </group>

                    </sheet>
                    <chatter/>
                </form>
