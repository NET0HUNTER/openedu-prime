<search string="Attendance Sheet">
                    <field name="register_id"/>
                    <field name="attendance_date"/>
                    <newline/>
                    <filter string="Today" name="filter_attendance_today" domain="[('attendance_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter string=" Week" name="filter_attendance_week" domain="[('attendance_date', '&gt;=', (context_today()+relativedelta(weeks=-1,days=1,weekday=0)).strftime('%Y-%m-%d')),                     ('attendance_date', '&lt;=', (context_today()-relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Month" name="filter_attendance_month" domain="[('attendance_date', '&lt;=', (context_today()+relativedelta(day=31)).strftime('%Y-%m-%d')),                                     ('attendance_date', '&gt;=', (context_today()-relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Register" name="group_by_attendance_sheet_register_id" domain="[]" context="{'group_by':'register_id'}"/>
                        <filter string="Date" name="group_by_attendance_sheet_attendance_date" domain="[]" context="{'group_by':'attendance_date'}"/>
                    </group>
                </search>
