<kanban highlight_color="color" string="Attendance Register kanban" class="o_slide_kanban o_slide_channel_kanban o_attendance_kanban" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="color"/>
                <field name="code"/>
                <field name="course_id"/>
                <field name="batch_id"/>
                <field name="attendance_option"/>
                <field name="sheet_count"/>
                <field name="auto_create_type"/>
                <templates>
                    <t t-name="menu">
                        <div class="container" role="menu">
                            <div class="row my-2">
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_view">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_views" class="o_kanban_card_manage_title">
                                            <span>Views</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_new">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_new" class="o_kanban_card_manage_title">
                                            <span>New</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_operations">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_reports" class="o_kanban_card_manage_title">
                                            <span>Reports</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div t-if="widget.editable" class="o_kanban_card_manage_settings row">
                                <div role="menuitem" aria-haspopup="true" class="col-8">
                                    <field name="color" widget="kanban_color_picker"/>
                                </div>
                                <div role="menuitem" class="col-4">
                                    <a type="open">Settings</a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <main class="d-flex flex-column gap-2 p-1 position-relative h-100">
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="d-flex flex-column gap-1 w-100" style="min-width: 0;">
                                    <h5 class="mb-0 fw-bold text-primary text-truncate" t-att-title="record.name.value" style="font-size: 1.15rem;">
                                        <field name="name"/>
                                    </h5>
                                </div>
                                <div class="flex-shrink-0">
                                    <span t-if="record.auto_create_type.raw_value == 'daily'" class="badge rounded-pill text-bg-success">Daily</span>
                                    <span t-if="record.auto_create_type.raw_value == 'weekly'" class="badge rounded-pill text-bg-warning">Weekly</span>
                                    <span t-if="record.auto_create_type.raw_value == 'monthly'" class="badge rounded-pill text-bg-info">Monthly</span>
                                </div>
                            </div>
                            
                            <div class="d-flex flex-column gap-1 mb-1 mt-2">
                                <div t-if="record.course_id.raw_value" class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-book me-2" role="img" aria-label="Course" title="Course"/>
                                    <field name="course_id"/>
                                </div>
                                <div t-if="record.batch_id.raw_value" class="d-flex align-items-center small text-muted text-truncate">
                                    <i class="fa fa-users me-2" role="img" aria-label="Batch" title="Batch"/>
                                    <field name="batch_id"/>
                                </div>
                            </div>
                            
                            <div class="row g-2" name="metrics_grid">
                                <div class="col-12">
                                    <button name="1434" type="action" class="btn d-flex align-items-center justify-content-between text-decoration-none bg-light p-2 rounded h-100 border border-light-subtle w-100" style="background-color: #f8f9fa !important; min-width: 0; box-shadow: none;">
                                        <span class="d-flex align-items-center text-muted small" style="min-width: 0;">
                                            <i class="fa fa-clipboard me-2 text-dark flex-shrink-0" title="Attendance Sheets"/>
                                            <span class="text-truncate">Attendance Sheets</span>
                                        </span>
                                        <span class="badge rounded-pill bg-dark-subtle text-dark fw-bold fs-6 flex-shrink-0 ms-2">
                                            <field name="sheet_count"/>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
