<list string="Registration">
                    <field name="application_number"/>
                    <field name="title" optional="show"/>
                    <field name="name"/>
                    <field name="admission_date"/>
                    <field name="application_date"/>
                    <field name="course_id" on_change="1"/>
                    <field name="batch_id" optional="hide"/>
                    <field name="state" string="Status" widget="badge" decoration-muted="state in ('draft')" decoration-success="state in ('done','confirm')" decoration-primary="state in ('submit','admission','pending')" decoration-danger="state in ('cancel')" optional="show" on_change="1"/>
                    <field name="company_id" optional="show"/>
                    <field name="gender" optional="hide"/>
                    <field name="birth_date" optional="hide"/>
                    <field name="email" optional="hide"/>
                <button name="1323" type="action" string="Email" icon="fa-envelope" invisible="state == 'done'"/>
                </list>
