<form string="Course Change Request">
                <header>
                    <button name="action_draft" invisible="state in ['draft','course_change_fees','approve','reject']" string="Reset To Draft" type="object" class="oe_highlight"/>
                    <button name="action_course_change_fees" invisible="state in ['course_change_fees','approve','reject','cancel']" string="Fees Payment" type="object" class="oe_highlight"/>
                    <button name="action_approve" invisible="state in ['draft','approve','reject','cancel']" string="Approve" type="object" class="oe_highlight"/>
                    <button name="action_cancel" invisible="state in ['cancel','draft']" string="Cancel" type="object" class="oe_highlight"/>
                    <button name="action_reject" invisible="state in ['course_change_fees','approve','reject','cancel']" string="Reject" type="object" class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="student_id" on_change="1" can_create="True" can_write="True"/>
                    </group>
                    <group>
                        <group>
                            <field name="from_course_id_domain" invisible="1"/>
                            <field name="from_course_id" domain="from_course_id_domain" can_create="True" can_write="True"/>
                            <field name="product_id" can_create="True" can_write="True"/>
                           <field name="company_id" can_create="True" can_write="True"/>
                        </group>
                        <group>
                            <field name="to_course_id" on_change="1" can_create="True" can_write="True"/>
                            <field name="approve_date" widget="date"/>
                            <field name="order_id" can_create="True" can_write="True"/>
                        </group>
                        <group>
                            <field name="reason_to_change"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
