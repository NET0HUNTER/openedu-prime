<search string="Admission Register">
                    <field name="name"/>
                    <field name="course_id"/>
                    <field name="product_id"/>
                    <separator/>
                    <group>
                        <filter string="Course" name="group_by_adm_reg_course_id" domain="[]" context="{'group_by':'course_id'}"/>
                        <filter string="Fees" name="group_by_adm_reg_product_id" domain="[]" context="{'group_by':'product_id'}"/>
                        <filter string="Status" name="group_by_adm_reg_state" domain="[]" context="{'group_by':'state'}"/>
                        <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                        <filter string="Favorites" name="group_by_adm_reg_favorite" domain="[('is_favorite', '=', True)]"/>
                    </group>
                <searchpanel>
                    <field name="course_id" icon="fa fa-book"/>
                </searchpanel>
                </search>
