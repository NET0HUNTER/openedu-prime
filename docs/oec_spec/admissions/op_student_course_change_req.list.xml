<list>
                <field name="name"/>
                <field name="student_id"/>
                <field name="from_course_id"/>
                <field name="to_course_id" on_change="1"/>
                <field name="state" string="Status" widget="badge" decoration-muted="state in ('draft')" decoration-success="state in ('approve')" decoration-primary="state in ('course_change_fees')" decoration-danger="state in ('cancel','reject')" optional="show"/>
                <field name="company_id" optional="show"/>
            </list>
