<form string="Team Members">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active== True"/>
                    <div class="oe_title" id="title">
                        <label for="name" class="oe_edit_only"/>
                        <h1 id="name">
                            <field name="name" placeholder="Helpdesk Team..."/>
                        </h1>
                    </div>
                    <div class="row mt16 o_settings_container">
                        <div class="col-lg-6 o_setting_box" title="With random assignation, every user gets the same number of tickets. With balanced assignation, tickets are assigned to the user with the least amount of open tickets.">
                            <div class="o_setting_right_pane">
                                <label for="assignment_method"/>
                                <div class="text-muted">
                                    How to assign newly created tickets to the right person.
                                </div>
                                <div class="o_field_radio o_vertical o_field_widget o_required_modifier mt16 o_light_label">
                                    <field name="assignment_method" widget="radio"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="visibility_member_ids">Team Visibility</label>
                                <div class="text-muted">
                                    Team Members to whom this team will be visible. Keep empty for everyone to see this
                                    team.
                                </div>
                                <div>
                                    <field name="visibility_member_ids" widget="many2many_tags" can_create="True" can_write="True"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div>
                        <field name="is_rating"/>
                        <label for="is_rating">Ratings On Tickets</label>
                        <div class="text-muted">
                            Allow your customers to easily rate your services. Activate this option will add a default
                            email template on non folded closing stages.
                        </div>
                    </div>
                    <div>
                        <label for="rating_avg" invisible="is_rating != True">Rating Average</label>
                        <field name="rating_avg" invisible="is_rating != True"/>
                    </div>
                    <group>
                        <group>
                            <field name="stage_ids" widget="many2many_tags" required="1" can_create="True" can_write="True"/>
                            <field name="mail_template_id" can_create="True" can_write="True"/>
                            <field name="company_id" required="1" can_create="True" can_write="True"/>
                        </group>
                        <group>
                            <field name="issue_type_ids" required="1" widget="many2many_tags" can_create="True" can_write="True"/>
                            <field name="mail_close_tmpl_id" can_create="True" can_write="True"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group name="group_alias">
                        <div class="mt16">
                            <div class="oe_edit_only d-flex">
                                <label for="alias_id" string="Send emails to:"/>
                                <field name="alias_name" class="col-md-4" on_change="1"/>@
                                <field name="alias_domain" class="oe_inline" readonly="1"/>
                                to create tickets
                            </div>
                            <p class="oe_read_only">Send emails to
                                <strong>
                                    <field name="alias_id" class="oe_read_only oe_inline" required="False" on_change="1" can_create="True" can_write="True"/>
                                </strong>
                                to create tickets
                            </p>
                        </div>
                    </group>
                    <field name="description" placeholder="Description for customer portal"/>
                    <notebook>
                        <page name="members" string="Team Members">
                            <field name="member_ids" widget="many2many_tags" can_create="True" can_write="True">
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>