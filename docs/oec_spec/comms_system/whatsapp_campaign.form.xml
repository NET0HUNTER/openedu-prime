<form string="Whatsapp Campaign Form">
                    <header>
                        <button name="action_start_campaign" type="object" invisible="state not in ['draft','stopped']" class="btn-primary" string="Start"/>
                        <button name="action_stop_campaign" type="object" invisible="state != 'running'" class="btn-primary" string="Stop"/>
                        <button name="generate_campaign_participants" string="Generate Participants" class="btn-secondary" type="object" invisible="state != 'running'"/>
                        <button name="execute_activities" type="object" invisible="state != 'running'" class="btn-secondary" string="Execute Activities"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,running,stopped"/>

                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="campaign_participants" type="object" icon="fa-code-fork fa-rotate-180 fa-flip-vertical" class="oe_stat_button">
                                <field name="total_participant_count" widget="statinfo" string="Participants"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <span class="oe_edit_only">Name</span>
                            <h1><field name="name" required="1"/></h1>
                        </div>
                        <group>
                            <field name="whatsapp_business_id" options="{'no_create_edit': True, 'no_create': True, 'no_open': True}" class="oe_inline" can_create="True" can_write="True"/>
                            <field name="model_id" string="Target" class="oe_inline" options="{'no_create_edit': True, 'no_create': True, 'no_open': True}" on_change="1" can_create="True" can_write="True"/>
                            <field name="unique_field_id" string="Unicity based on " options="{'no_create_edit': True, 'no_open': True}" class="oe_inline" can_create="True" can_write="True" invisible="1" column_invisible="1"/>
                            <field name="model_name" invisible="1"/>
                            <field name="domain" widget="domain" options="{'model': 'model_name'}" on_change="1"/>
                        </group>
                        <div class="o_ma_hierarchy">
                            <div class="o_ma_hierarchy_title" invisible="whatsapp_campaign_activity_line == []">Workflow</div>
                            <div class="o_ma_hierarchy_readonly oe_read_only" invisible="whatsapp_campaign_activity_line != []">
                                <h3>No activity added</h3>
                                <p>
                                    Click on 'Add new message' button to add new activity in workflow.
                                </p>
                            </div>
                            <!--  -->
                            <field name="whatsapp_campaign_activity_line" widget="Whastapp_kanban_hierarchy" mode="kanban" nolabel="1" class="o_ma_hierarchy_container o_ma_campaign_hierarchy" add-label="Add new message" on_change="1">
                            <kanban>
                                    <field name="id" invisible="1"/>
                                    <field name="name" invisible="1"/>
                                    <field name="parent_id" invisible="1" on_change="1"/>
                                    <field name="model_id" invisible="1" on_change="1"/>
                                    <field name="model_name" invisible="1"/>
                                    <field name="domain" invisible="1" on_change="1"/>
                                    <field name="activity_domain" invisible="1" on_change="1"/>
                                    <field name="processed" invisible="1"/>
                                    <field name="rejected" invisible="1"/>
                                    <field name="total_sent" invisible="1"/>
                                    <field name="total_delivered" invisible="1"/>
                                    <field name="total_read" invisible="1"/>
                                    <field name="total_replied" invisible="1"/>
                                    <field name="allowed_parent_ids" invisible="1"/>
                                    <templates>
                                        <div t-name="card">
                                            <div class="o_ma_body">
                                                <t t-call="timeline"/>
                                                <div class="o_ma_card">
                                                    <div>
                                                        <div class="o_ma_title_bar">
                                                            <div class="o_ma_icon">
                                                                <span t-attf-class="fa fa-whatsapp" role="img" aria-label="Whatsapp"/>
                                                            </div>
                                                            <div class="o_ma_title">
                                                                <h4 class="mb0 mt0 activity_title"><a type="edit" t-attf-class="oe_kanban_action oe_kanban_action_a #{read_only_mode and 'o_ma_full' or None}"><field name="name"/></a></h4>
                                                            </div>
                                                             <div class="o_ma_switch">
                                                        <div t-if="!read_only_mode" class="float-start mt8 mr4">
                                                            <a type="edit" role="button" class="btn btn-primary btn-sm" href="#">Edit</a>
                                                            <a type="delete" role="button" class="btn btn-link btn-sm" href="#">Delete</a>
                                                        </div>
                                                        <span role="img" title="Graph" aria-label="Graph" class="o_ma_activity_tab active" data-tab-type="graph">
                                                            <i class="fa fa-pie-chart"/>
                                                        </span>
                                                        <span title="Filter" role="img" aria-label="Filter" class="o_ma_activity_tab" data-tab-type="filter">
                                                            <i class="fa fa-filter"/>
                                                        </span>
                                                    </div>
                                                        </div>
                                                        <div class="o_pane o_pane_graph">
                                                            <div class="pb-3 row">
                                                                <div class="col-lg-8 col-8 o_ma_graph mb10">
                                                                    <t t-if="record.statistics_graph_data.value">
                                                                        <field name="statistics_graph_data" widget="whatsapp_activity_graph"/>
                                                                    </t>
                                                                </div>
                                                                <div class="col-lg-4 col-4 graph_details mt-4">
                                                                    <div class="col-12" style="margin-bottom:5px;">
                                                                        <a name="action_sent" type="object">
                                                                            <strong><t t-esc="record.total_sent.raw_value or 0"> </t></strong><span class="ps-2"><i class="fa fa-check-circle"/> Send</span>
                                                                        </a>
                                                                    </div>
                                                                    <div class="col-12" style="margin-bottom:5px;">
                                                                        <a name="action_delivered" type="object">
                                                                            <strong><t t-esc="record.total_delivered.raw_value or 0"> </t></strong><span class="ps-2"><i class="fa fa-check-circle"/> Delivered</span>
                                                                        </a>
                                                                    </div>
                                                                    <div class="col-12" style="margin-bottom:5px;">
                                                                        <a name="action_read" type="object">
                                                                            <strong><t t-esc="record.total_read.raw_value or 0"> </t></strong><span class="ps-2"><i class="fa fa-check-circle"/> Read</span>
                                                                        </a>
                                                                    </div>
                                                                    <div class="col-12" style="margin-bottom:5px;">
                                                                        <a name="action_replied" type="object">
                                                                            <strong><t t-esc="record.total_replied.raw_value or 0"> </t></strong><span class="ps-2"><i class="fa fa-check-circle"/> Replied</span>
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="row o_ma_email_details text-center">
                                                                <div class="col m-2">
                                                                    <span class="mt4 mb4" style="font-size: 25px;color: #00A141;"><t t-esc="record.processed.value or 0"/></span>
                                                                    <span style="text-align: center;font-size: 18px;">Success</span>
                                                                </div>
                                                                <div class="col m-2">
                                                                    <span class="mt4 mb4 o_ma_text_rejected" style="font-size: 25px;"><t t-esc="record.rejected.value or 0"> </t></span>
                                                                    <span style="font-size: 18px;">Rejected</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="o_pane o_pane_filter d-none"/>
                                                        <div t-if="!read_only_mode" class="o_ma_child_activity text-center">
                                                            <div class="o_ma_child_activity_title card-footer">
                                                                <i class="fa fa-plus-circle"/>
                                                                        Add child activity
                                                            </div>
                                                            <div class="o_ma_child_activity_buttons">
                                                                <i data-trigger-type="activity" class="fa fa-rotate-180 o_ma_text_processed add_child_activity text-success" title="Add Another Activity" role="img" aria-label="Add Another Activity">
                                                                    <img class="o_ma_icon o_ma_icon_primary" src="/whatsapp_core/static/img/add.svg" height="20px" alt="Add"/>
                                                                </i>
                                                                <i data-trigger-type="sent" class="fa o_ma_text_processed add_child_activity text-success" title="Sent Activity" role="img" aria-label="Sent Activity">
                                                                    <img class="o_ma_icon" src="/whatsapp_core/static/img/check-mark.svg" height="20px" alt="Add"/>
                                                                </i>
                                                                <i data-trigger-type="delivered" class="fa o_ma_text_processed add_child_activity text-success" title="delivered Activity" role="img" aria-label="delivered Activity">
                                                                    <img class="o_ma_icon" src="/whatsapp_core/static/img/seen.svg" height="20px" alt="Add"/>
                                                                </i>
                                                                <i data-trigger-type="read" class="fa o_ma_text_processed add_child_activity text-success" title="read Activity" role="img" aria-label="read Activity">
                                                                    <img class="o_ma_icon o_ma_icon_primary msg-dblcheck-read" src="/whatsapp_core/static/img/seen.svg" style="color: #009efb;" height="20px" alt="Add"/>
                                                                </i>
                                                                <i data-trigger-type="replied" class="fa o_ma_text_processed add_child_activity text-success" title="replied Activity" role="img" aria-label="replied Activity">
                                                                    <img class="o_ma_icon o_ma_icon_primary" src="/whatsapp_core/static/img/reply.svg" height="20px" alt="Add"/>
                                                                </i>
                                                            </div>
                                                            </div>
                                                    </div>

                                                </div>
                                                <div class="o_hierarchy_children"/>
                                            </div>
                                        </div>
                                        <t t-name="timeline">
                                            <div class="o_ma_timeline text-center">
                                                <strong class="o_ma_interval">
                                                    <i class="fa fa-clock-o" role="img" aria-label="Select time" title="Select time"/> <field name="interval_number"/>
                                                    <field name="interval_type"/>
                                                </strong>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                        </field>
                        </div>
                    </sheet>
                </form>