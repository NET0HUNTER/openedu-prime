<kanban create="false" highlight_color="color" class="o_kanban_mobile poly_wide_kanban">
                <field name="id"/>
                <field name="name"/>
                <field name="color"/>
                <field name="is_rating"/>
                <field name="helpdesk_count"/>
                <field name="unassigned_issues"/>
                <field name="urgent_count"/>
                <field name="failed_count"/>
                <field name="todo_today_count"/>
                <field name="overdue_count"/>
                <field name="solved_helpdesk_count"/>
                <field name="sla_success_rate"/>
                <field name="rating_avg"/>
                <field name="member_ids"/>
                <field name="issue_type_ids"/>
                <templates>
                    <t t-name="card">
                        <style>
                            .poly_wide_kanban .o_kanban_record {
                                flex: 1 1 400px !important;
                                width: 400px !important;
                            }
                        </style>
                        <div class="oe_kanban_global_click p-2 d-flex flex-column h-100" style="gap: 16px;">
                            
                            <!-- Header -->
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="d-flex align-items-center">
                                    <div class="d-flex justify-content-center align-items-center rounded bg-light border me-3" style="width: 44px; height: 44px; color: #475569;">
                                        <i class="fa fa-life-ring fs-4" title="Team"/>
                                    </div>
                                    <div>
                                        <h4 class="fw-bolder text-dark mb-0"><field name="name"/></h4>
                                        <div class="text-muted small mt-1">Helpdesk Team</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Primary KPIs -->
                            <div class="row g-3">
                                <div class="col-6">
                                    <a role="button" context="{'button_type': 'open', 'default_team_id': id}" name="action_view_ticket" type="object" class="d-flex flex-column justify-content-center align-items-center p-3 rounded h-100 text-decoration-none transition-colors" style="background-color: #eff6ff; border: 1px solid #bfdbfe;">
                                        <span class="fs-1 fw-bolder text-primary mb-1" style="line-height: 1;"><field name="helpdesk_count"/></span>
                                        <span class="small fw-bold text-primary text-uppercase" style="letter-spacing: 0.5px;">Open Tickets</span>
                                    </a>
                                </div>
                                <div class="col-6">
                                    <div class="d-flex flex-column justify-content-between h-100 p-2 rounded border bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted small fw-bold"><i class="fa fa-bolt text-warning"/> SLA</span>
                                            <span class="fw-bolder text-dark"><field name="sla_success_rate"/>%</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-2" t-if="record.is_rating.raw_value">
                                            <span class="text-muted small fw-bold"><i class="fa fa-star text-warning"/> Rating</span>
                                            <span class="fw-bolder text-dark"><field name="rating_avg"/></span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="text-muted small fw-bold"><i class="fa fa-check-circle text-success"/> Closed</span>
                                            <span class="fw-bolder text-dark"><field name="solved_helpdesk_count"/></span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-muted small fw-bold"><i class="fa fa-clock-o text-info"/> New</span>
                                            <span class="fw-bolder text-dark"><field name="todo_today_count"/></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Secondary Status Row -->
                            <div class="d-flex justify-content-between text-center pt-3 mt-auto border-top">
                                <a context="{'button_type': 'unassigned', 'default_team_id': id}" name="action_view_ticket" type="object" class="flex-grow-1 text-decoration-none">
                                    <div class="fs-4 fw-bold text-dark"><field name="unassigned_issues"/></div>
                                    <div class="small fw-bold text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Unassigned</div>
                                </a>
                                <div class="border-end mx-2"/>
                                <a context="{'button_type': 'urgent', 'default_team_id': id}" name="action_view_ticket" type="object" class="flex-grow-1 text-decoration-none">
                                    <div class="fs-4 fw-bold text-danger"><field name="urgent_count"/></div>
                                    <div class="small fw-bold text-danger text-uppercase opacity-75" style="font-size: 0.7rem; letter-spacing: 0.5px;">Urgent</div>
                                </a>
                                <div class="border-end mx-2"/>
                                <a context="{'button_type': 'overdue', 'default_team_id': id}" name="action_view_ticket" type="object" class="flex-grow-1 text-decoration-none">
                                    <div class="fs-4 fw-bold text-warning" style="color: #d97706 !important;"><field name="overdue_count"/></div>
                                    <div class="small fw-bold text-warning text-uppercase opacity-75" style="color: #d97706 !important; font-size: 0.7rem; letter-spacing: 0.5px;">Overdue</div>
                                </a>
                            </div>

                            <!-- Footer -->
                            <div class="d-flex justify-content-between align-items-center pt-2">
                                <div class="text-truncate">
                                    <field name="issue_type_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>
                                <field name="member_ids" widget="many2many_avatar_user"/>
                            </div>
                            
                        </div>
                    </t>
                </templates>
            </kanban>