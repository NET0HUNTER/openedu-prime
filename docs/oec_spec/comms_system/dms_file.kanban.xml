<kanban class="mk_file_kanban_view o_kanban_small_column align-content-start o_document_kanban" banner_route="/onboarding/dms_file_onboarding_panel" js_class="dms_file_kanban">
       
                <field name="id"/>
                <field name="tag_ids"/>
                <field name="name"/>
                <field name="color"/>
                <field name="active"/>
                <field name="mimetype" on_change="1"/>
                <field name="icon_url"/>
                <field name="create_uid"/>
                <field name="write_date"/>
                <field name="locked_by" on_change="1"/>
                <field name="is_locked"/>
                <field name="is_lock_editor"/>
                <field name="permission_write"/>
                <field name="permission_unlink"/>
                <field name="user_id"/>
                <templates>
                   
                    <t t-name="kanban-menu">
                        <div class="row">
                            <div class="col-6 mk_file_kanban_operations">
                                <h6 class="dropdown-header">
                                    Operations
                                </h6>
                                <a t-if="record.permission_write.raw_value and !record.is_locked.raw_value" role="menuitem" name="lock" type="object" class="dropdown-item">
                                    <i class="fa fa-lock"/>
                                    Lock
                                </a>
                                <a t-if="record.is_locked.raw_value  and record.is_lock_editor.raw_value" role="menuitem" name="unlock" type="object" class="dropdown-item">
                                    <i class="fa fa-unlock-alt"/>
                                    Unlock
                                </a>
                                <a t-if="record.permission_write.raw_value and record.active.raw_value" role="menuitem" name="toggle_active" type="object" class="dropdown-item">
                                    <i class="fa fa-archive"/>
                                    Archive
                                </a>
                                <a t-if="record.permission_write.raw_value and !record.active.raw_value" role="menuitem" name="toggle_active" type="object" class="dropdown-item">
                                    <i class="fa fa-archive"/>
                                    Unarchive
                                </a>
                                <a role="menuitem" class="dropdown-item" t-attf-href="/web/content?id=#{record.id.raw_value}&amp;field=content&amp;model=dms.file&amp;filename_field=name&amp;download=true">
                                    <i class="fa fa-download"/>
                                    Download
                                </a>
                            </div>
                            <div class="col-6 border-left mk_file_kanban_actions">
                                <h6 class="dropdown-header">
                                    Actions
                                </h6>
                                <a role="menuitem" type="open" class="dropdown-item">
                                    <i class="fa fa-external-link"/>
                                    Open
                                </a>
                                <a t-if="record.permission_write.raw_value" role="menuitem" type="edit" class="dropdown-item">
                                    <i class="fa fa-pencil-square-o"/>
                                    Edit
                                </a>
                                <a t-if="record.permission_unlink.raw_value" role="menuitem" type="delete" class="dropdown-item">
                                    <i class="fa fa-trash-o"/>
                                    Delete
                                </a>
                            </div>
                        </div>
                        <div style="text-align: -webkit-center;">
                            <div class="row">
                                <div class="col-12">
                                    <ul class="oe_kanban_colorpicker" data-field="color"/>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color} d-flex flex-column h-100 bg-white border-0 position-relative p-0" style="box-shadow: 0 4px 15px rgba(0,0,0,0.06);">
                            
                            <!-- Premium Preview Area -->
                            <div class="position-relative preview_file_trigger w-100 d-flex justify-content-center align-items-center" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); height: 120px; border-bottom: 1px solid rgba(0,0,0,0.05);" draggable="true" t-att-data-id="record.id" t-att-data-name="record.name.raw_value" t-att-data-mimetype="record.mimetype.raw_value">
                                
                                <!-- Glassmorphic Floating Lock Badge -->
                                <div t-if="record.is_locked.raw_value" class="position-absolute d-flex align-items-center justify-content-center" style="top: 10px; right: 10px; background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(4px); padding: 4px 8px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); border: 1px solid rgba(255,255,255,0.5);">
                                    <i class="fa fa-lock text-danger me-1" style="font-size: 0.75rem;"/>
                                    <span class="text-danger fw-bolder" style="font-size: 0.65rem;">LOCKED</span>
                                </div>
                                
                                <!-- Smart Preview (Image vs Icon) -->
                                <t t-set="is_webimage" t-value="new RegExp('image.*(gif|jpeg|jpg|png|svg)').test(record.mimetype.raw_value)"/>
                                
                                <t t-if="is_webimage">
                                    <img class="preview-image" t-attf-src="/web/image?model=dms.file&amp;id=#{record.id.raw_value}&amp;field=content" alt="Preview" style="width: 100%; height: 100%; object-fit: cover;"/>
                                </t>
                                <t t-else="">
                                    <img class="preview-image" t-att-src="record.icon_url.raw_value" alt="Icon" style="max-height: 65px; object-fit: contain;"/>
                                </t>
                            </div>
                            
                            <!-- Modern Info Area -->
                            <div class="d-flex flex-column p-3 bg-white w-100 flex-grow-1">
                                
                                <!-- Title (Pinned to top for perfect alignment) -->
                                <h5 class="fw-bold text-dark mb-2" style="font-size: 1.05rem; letter-spacing: -0.2px; line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; text-overflow: ellipsis; word-break: break-all;">
                                    <field name="name" t-att-data-id="widget.db_id"/>
                                </h5>
                                
                                <!-- Tags (Rendered below title if present) -->
                                <div t-if="record.tag_ids.raw_value.length &gt; 0" class="mb-2">
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </div>
                                
                                <!-- Sleek Footer -->
                                <div class="d-flex justify-content-between align-items-center w-100 mt-auto pt-2" style="border-top: 1px solid #f0f0f0;">
                                    <!-- Date Info -->
                                    <div class="d-flex flex-column justify-content-center">
                                        <span style="font-size: 0.65rem; color: #adb5bd; text-transform: uppercase; font-weight: 700; letter-spacing: 0.5px;">Modified</span>
                                        <span class="text-dark fw-medium" style="font-size: 0.85rem;">
                                            <t t-set="datetime" t-value="record.write_date.raw_value"/>
                                            <t t-if="datetime">
                                                <t t-esc="datetime.split('T')[0]"/>
                                            </t>
                                        </span>
                                    </div>
                                    
                                    <!-- Right Side: Attractive User Info -->
                                    <div class="d-flex align-items-center gap-2" style="opacity: 1 !important; visibility: visible !important;">
                                        <field name="user_id" widget="many2one_avatar_user"/>
                                        <div class="text-truncate" style="max-width: 90px;">
                                            <field name="user_id" class="text-dark fw-bold" style="font-size: 0.75rem;"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>

                   
                </templates>
            </kanban>