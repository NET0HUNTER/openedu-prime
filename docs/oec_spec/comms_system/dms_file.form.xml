<form string="Files">
                <header>
                    <button class="oe_highlight" name="lock" type="object" string="Lock" invisible="is_locked != False or permission_write == False"/>
                    <button class="oe_highlight" name="unlock" type="object" string="Unlock" invisible="is_locked == False or is_lock_editor == False"/>
                    <button name="261" string="Share" type="action" class="oe_highlight oe_read_only"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <div class="oe_button_box" name="button_box"/>
                    <field name="image_1920" widget="image" class="oe_avatar" nolabel="1" options="{'image_preview': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" on_change="1"/>
                            <field name="active" invisible="1"/>
                        </h1>
                        <h4>
                            <field name="path_json" widget="path_json" options="{'prefix': True, 'suffix': False}" invisible="name == False or directory_id == False"/>
                        </h4>
                    </div>
                    <group name="content">
                        <group>
                            <field name="content" filename="name" mimetype="mimetype" widget="preview_binary" readonly="content" force_save="1" on_change="1"/>
                        </group>
                        <group>
                            <field name="extension"/>
                            <field name="mimetype" on_change="1"/>
                        </group>
                    </group>
                    <group name="settings">
                        <group>
                            <field name="directory_id" options="{'no_quick_create': True}" on_change="1" can_create="True" can_write="True"/>
                            <field name="storage_id" options="{}" on_change="1"/>
                        </group>
                        <group>
                            <field name="category_id" placeholder="Internal / Human Resource" options="{'no_open': True, 'no_create': True}" on_change="1" can_create="True" can_write="True"/>
                            <field name="tag_ids" widget="many2many_tags" placeholder="Tags..." options="{'color_field': 'color', 'no_create_edit': True}" can_create="True" can_write="True"/>
                        </group>
                    </group>
                    <group>
                        <field name="storage_id_save_type" invisible="True"/>
                        <field name="res_model" readonly="True" invisible="storage_id_save_type != 'attachment'" on_change="1"/>
                        <field name="res_id" readonly="True" invisible="storage_id_save_type != 'attachment'" on_change="1"/>
                        <field name="record_ref" invisible="storage_id_save_type != 'attachment'"/>
                    </group>
                    <notebook>
                        <page name="page_meta" string="Meta Information">
                            <group>
                                <group>
                                    <field name="create_date" readonly="1"/>
                                    <field name="create_uid" readonly="1"/>
                                </group>
                                <group>
                                    <field name="write_date" readonly="1"/>
                                    <field name="write_uid" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page name="page_access" string="Access Information">
                            <group>
                                <group>
                                    <field name="permission_write" readonly="1"/>
                                    <field name="permission_unlink" readonly="1"/>
                                </group>
                                <group>
                                    <field name="is_lock_editor" invisible="1"/>
                                    <field name="is_locked" invisible="1"/>
                                    <field name="locked_by" on_change="1" can_create="True" can_write="True"/>
                                </group>
                            </group>
                        </page>
                        <page name="page_technical" string="Technical Information" invisible="1" column_invisible="1">
                            <group name="technical">
                                <group name="technical_left">
                                </group>
                                <group name="technical_right">
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>