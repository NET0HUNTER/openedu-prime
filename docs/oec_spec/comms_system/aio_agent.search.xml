<search string="Search AI Agents">
                <field name="name"/>
                <field name="model_id"/>
                <field name="collection_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                <separator/>
                <filter string="Status" name="state" context="{'group_by': 'state'}"/>
                <filter string="Model" name="model" context="{'group_by': 'model_id'}"/>
                <filter string="Collection" name="collection" context="{'group_by': 'collection_id'}"/>
            </search>