<form string="Website Page Settings">
            <sheet>
                <group>
                    <group>
                        <field name="name" on_change="1"/>
                        <field name="url"/>
                        <field name="view_id" context="{'display_website': True}" on_change="1" can_create="True" can_write="True"/>
                        <field name="website_id" options="{'no_create': True}" can_create="True" can_write="True"/>
                        <field name="track" on_change="1"/>
                    </group>
                    <group>
                        <field name="website_indexed"/>
                        <field name="is_published"/>
                        <field name="date_publish"/>
                    </group>
                </group>
                <label for="menu_ids" string="Related Menu Items"/>
                <field name="menu_ids"><list string="Website menu">
                    <field name="sequence" widget="handle"/>
                    <field name="website_id" options="{'no_create': True}"/>
                    <field name="name"/>
                    <field name="url"/>
                    <field name="is_mega_menu" on_change="1"/>
                    <field name="new_window"/>
                    <field name="parent_id" context="{'display_website': True}" on_change="1"/>
                    <field name="group_ids" widget="many2many_tags"/>
                </list></field>
            </sheet>
        </form>