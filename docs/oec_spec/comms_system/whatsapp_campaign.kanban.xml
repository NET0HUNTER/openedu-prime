<kanban class="o_whatsapp_kanban" default_group_by="state" quick_create="false" sample="1">
                    <field name="name"/>
                    <field name="state" readonly="1"/>
                    <field name="total_participant_count"/>
                    <field name="running_participant_count"/>
                    <templates>
                        <t t-name="card">
                            <main class="d-flex flex-column h-100 p-1 position-relative bg-white rounded">
                                <!-- Header Area -->
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h5 class="fw-bold text-primary mb-0 text-truncate pe-2" style="font-size: 1.1rem; line-height: 1.4;">
                                        <field name="name"/>
                                    </h5>
                                    <div class="rounded-pill border border-primary text-primary bg-white d-flex align-items-center px-2 py-1 flex-shrink-0" style="font-size: 0.8rem; font-weight: 600;">
                                        <i class="fa fa-users me-1"/>
                                        <t t-esc="record.total_participant_count.raw_value"/> Total
                                    </div>
                                </div>
                                
                                <!-- Metrics Area -->
                                <t t-set="calc_completed" t-value="record.total_participant_count.raw_value - record.running_participant_count.raw_value"/>
                                <div class="d-flex justify-content-between align-items-end mb-2 mt-auto">
                                    <div class="d-flex flex-column">
                                        <span class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Completed</span>
                                        <span class="fw-bold text-success lh-1 mt-1" style="font-size: 1.25rem;"><t t-esc="calc_completed"/></span>
                                    </div>
                                    <div class="d-flex flex-column text-end">
                                        <span class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.5px;">Running</span>
                                        <span class="fw-bold text-primary lh-1 mt-1" style="font-size: 1.25rem;"><field name="running_participant_count"/></span>
                                    </div>
                                </div>
                                
                                <!-- Progress Bar -->
                                <t t-set="total" t-value="record.total_participant_count.raw_value || 1"/>
                                <t t-set="completed_pct" t-value="(calc_completed / total) * 100"/>
                                <t t-set="running_pct" t-value="(record.running_participant_count.raw_value / total) * 100"/>
                                
                                <div class="progress" style="height: 6px; border-radius: 3px; background-color: #f1f5f9;">
                                    <div class="progress-bar bg-success" role="progressbar" t-attf-style="width: #{completed_pct}%;" aria-valuemin="0" aria-valuemax="100"/>
                                    <div class="progress-bar bg-primary progress-bar-striped opacity-75" role="progressbar" t-attf-style="width: #{running_pct}%;" aria-valuemin="0" aria-valuemax="100"/>
                                </div>
                            </main>
                        </t>
                    </templates>
                </kanban>