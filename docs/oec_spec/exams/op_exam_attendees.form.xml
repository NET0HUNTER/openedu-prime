<form string="Exam Attendees">
                    <sheet>
                        <group>
                            <group>
                                <field name="course_id" invisible="1"/>
                                <field name="batch_id" invisible="1"/>
                                <field name="exam_id" on_change="1" can_create="True" can_write="True"/>
                                <field name="status"/>
                                <field name="room_id" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="student_id" domain="[('course_detail_ids.course_id','=',course_id),('course_detail_ids.batch_id','=',batch_id)]" can_create="True" can_write="True"/>
                                <field name="marks" on_change="1"/>
                            </group>
                        </group>
                        <group string="Note">
                            <field name="note" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
