<form string="Exam">
                    <header>
                        <button name="1190" invisible="state != 'draft'" type="action" string="Schedule Exam" class="oe_highlight"/>
                        <button name="1191" invisible="state != 'schedule'" type="action" string="Held Exam" class="oe_highlight"/>
                        <button name="act_done" invisible="state != 'result_updated'" type="object" string="Done" class="oe_highlight"/>
                        <button name="act_draft" invisible="state != 'cancel'" type="object" string="Draft" class="oe_highlight"/>
                        <button string="Result Updated" class="oe_highlight" invisible="state != 'held' or not results_entered" type="object" name="act_result_updated"/>
                        <button name="act_cancel" invisible="state not in ['draft', 'held', 'schedule']" type="object" string="Cancel"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,held,scheduled,result_updated,done"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                                <button class="oe_stat_button" name="open_exam_attendees" type="object" icon="fa-user-circle" string="Attendees">
                                    <field string="Attendees" name="attendees_count" widget="statinfo"/>
                            </button>
                        </div>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                            <h1><field class="w-100 w-md-50" name="name" readonly="state in ['held', 'done', 'cancel']" placeholder="Exam Name "/></h1>
                        <group>
                            <group>
                                <field name="session_id" required="1" readonly="state in ['held', 'done', 'cancel']" can_create="True" can_write="True"/>
                                <field name="exam_code" readonly="state in ['held', 'done', 'cancel']"/>
                                <field name="total_marks" readonly="state in ['held', 'done', 'cancel']"/>
                                <field name="subject_id" readonly="state in ['held', 'done', 'cancel']" can_create="True" can_write="True"/>
                <field name="grading_assignment_id" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="start_time" readonly="state in ['held', 'done', 'cancel']"/>
                                <field name="end_time" readonly="state in ['held', 'done', 'cancel']"/>
                                <field name="min_marks" readonly="state in ['held', 'done', 'cancel']"/>
                <field name="faculty_id" can_create="True" can_write="True"/>
                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                        </group>
                        <separator colspan="2" string="Description"/>
                        <field name="note" colspan="2"/>
                    </sheet>
                   <chatter/>
                <field name="results_entered" invisible="True" readonly="True" data-used-by="invisible=&quot;state != 'held' or not results_entered&quot; (button,act_result_updated)"/>
</form>
