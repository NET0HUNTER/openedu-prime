<form string="Quiz">
                <sheet>
                    <div class="oe_title">
                        <label for="question" string="Question Name"/>
                        <h1>
                            <field options="{'line_breaks': False}" widget="text" name="question" default_focus="1" placeholder="e.g. What powers a computer?"/>
                        </h1>
                        <field name="company_id" optional="show" can_create="True" can_write="True"/>
                    </div>
                    <field name="answer_ids">
                        <list editable="bottom" create="true" delete="true">
                            <field name="display_name" column_invisible="True"/>
                            <field name="text_value" on_change="1"/>
                            <field name="is_correct"/>
                            <field name="comment"/>
                        </list>
                    </field>
                </sheet>
            </form>