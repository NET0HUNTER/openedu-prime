<list decoration-info="(state == 'draft')" decoration-muted="(state == 'close')">
                <field name="name"/>
                <field name="category_id" string="Asset Category" on_change="1"/>
                <field name="date" on_change="1"/>
                <field name="partner_id" string="Vendor"/>
                <field name="value" on_change="1"/>
                    <field name="assign_state" optional="hide"/>
                <field name="value_residual" widget="monetary"/>
                
                <field name="company_id" on_change="1"/>
                <field name="state" optional="show" widget="badge" decoration-primary="state == 'draft'" decoration-success="state == 'open'" decoration-warning="state == 'oe_paused'" decoration-muted="state == 'close'"/>
            </list>