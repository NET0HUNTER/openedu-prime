<list sample="1" decoration-muted="state == 'reconciled'" decoration-info="state == 'draft'">
                <field name="name" readonly="state != 'draft'"/>
                <field name="journal_id" readonly="state != 'draft'" on_change="1"/>
                <field name="date" readonly="state != 'draft'"/>
                <field name="amount"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="currency_id" column_invisible="True" on_change="1"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'sent'"/>
            </list>