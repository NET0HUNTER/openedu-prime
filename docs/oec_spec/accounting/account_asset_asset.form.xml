<form string="Asset">
                <header>
                    <button name="validate" invisible="state != 'draft'" string="Confirm" type="object" class="oe_highlight"/>
                    <button type="object" name="compute_depreciation_board" string="Compute Depreciation" invisible="state != 'draft'"/>
                    <button name="655" invisible="state != 'open' or oe_has_unposted_disposal" string="Modify Depreciation" type="action" context="{'default_oe_action': 'modify'}"/>
                    <button name="655" invisible="state != 'open' or oe_has_unposted_disposal" string="Pause Depreciation" type="action" context="{'default_oe_action': 'pause'}" class="oe_highlight"/>
                    <button name="action_oe_resume" invisible="state != 'oe_paused'" string="Resume Depreciation" type="object" class="oe_highlight"/>
                    <button name="action_oe_sell" invisible="state != 'open' or oe_has_unposted_disposal" string="Sell Asset" type="object" class="oe_highlight"/>
                    <button name="action_oe_dispose" invisible="state != 'open' or oe_has_unposted_disposal" string="Dispose Asset" type="object" class="oe_highlight"/>
                    <button name="set_to_draft" string="Set to Draft" type="object" invisible="entry_count != 0 or state not in ['open', 'close']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,oe_paused" on_change="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="open_entries" type="object" icon="fa-bars">
                            <field string="Posted Entries" name="entry_count" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="state != 'draft'" placeholder="e.g. Laptop iBook"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id" string="Asset Category" domain="[('type', '=', 'purchase')]" readonly="state != 'draft'" context="{'default_type': 'purchase'}" help="Category of asset" on_change="1" can_create="True" can_write="True"/>
                            <field name="code" readonly="state != 'draft'"/>
                            <field name="date" help="Date of asset" readonly="state != 'draft'" on_change="1"/>
                            <field name="date_first_depreciation" readonly="state != 'draft'" on_change="1"/>
                            <field name="first_depreciation_manual_date" invisible="date_first_depreciation != 'manual'" required="date_first_depreciation == 'manual'" readonly="state != 'draft'"/>
                            <field name="type" invisible="1"/>
                            <field name="oe_pause_date" invisible="state != 'oe_paused'"/>
                            <field name="oe_has_unposted_disposal" invisible="1"/>
                            
                    <field name="assign_state"/>
                        </group>
                        <group>
                            
                            <field name="company_id" options="{'no_create': True}" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                            <field name="value" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'" help="Gross value of asset" on_change="1"/>
                            <field name="salvage_value" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="state != 'draft'" invisible="type == 'sale'" on_change="1"/>
                            <field name="value_residual" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="partner_id" string="Vendor" widget="res_partner_many2one" readonly="state != 'draft'" context="{'res_partner_search_mode': 'supplier'}" can_create="True" can_write="True"/>
                            <field name="invoice_id" string="Invoice" options="{'no_create': True}" readonly="state != 'draft'" can_create="True" can_write="True"/>
                            <field name="oe_disposal_date" invisible="state != 'close'"/>
                            <field name="oe_sale_value" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="state != 'close' or oe_sale_value == 0"/>
                            <field name="oe_disposal_move_id" invisible="state != 'close'"/>
<!--                            <field name="analytic_tag_ids" groups="analytic.group_analytic_accounting"-->
<!--                                   widget="many2many_tags"/>-->
                        </group>
                    </group>
                    <notebook colspan="4">
                        <page string="Depreciation Board">
                            <field name="depreciation_line_ids" mode="list" options="{'reload_whole_on_button': true}" readonly="state not in ['draft', 'open', 'oe_paused']" on_change="1">
                                <list decoration-info="(move_check == False)" create="false">
                                    <field name="depreciation_date"/>
                                    <field name="amount" widget="monetary" string="Depreciation" on_change="1"/>
                                    <field name="depreciated_value" readonly="1" string="Cumulative Depreciation"/>
                                    <field name="remaining_value" readonly="1" widget="monetary" string="Depreciable Value" on_change="1"/>
                                    <field name="move_id" string="Journal Entry" readonly="1" on_change="1"/>
                                    <field name="move_check" string="Linked"/>
                                    <field name="move_posted_check" string="Posted" on_change="1"/>
                                    <field name="parent_state" string="State of Asset"/>
                                </list>
                                <form string="Depreciation Lines" create="false">
                                    <group>
                                        <group>
                                            <field name="parent_state" invisible="1"/>
                                            <field name="name"/>
                                            <field name="sequence"/>
                                            <field name="move_id" on_change="1" can_create="True" can_write="True"/>
                                            <field name="move_check"/>
                                            <field name="parent_state" invisible="1"/>
                                        </group>
                                        <group>
                                            <field name="amount" widget="monetary" on_change="1"/>
                                            <field name="depreciation_date"/>
                                            <field name="depreciated_value"/>
                                            <field name="remaining_value" on_change="1"/>
                                        </group>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Depreciation Information">
                            <group>
                                <field name="method" widget="radio" invisible="type == 'sale'" readonly="state != 'draft'"/>
                                <field name="method_progress_factor" invisible="method == 'linear'" required="method in ['degressive', 'oe_degressive_then_linear']" readonly="state != 'draft'"/>
                                <field name="method_time" string="Time Method Based On" widget="radio" readonly="state != 'draft'" invisible="type != 'purchase'"/>
                                <field name="prorata" invisible="1" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <label for="method_number" invisible="method_time == 'end'"/>
                                <div invisible="method_time == 'end'">
                                    <field name="method_number" class="oe_inline" required="method_time == 'number'" readonly="state != 'draft'"/>
                                </div>
                                <label for="method_period" string="One Entry Every"/>
                                <div>
                                    <field name="method_period" nolabel="1" readonly="state != 'draft'" class="oe_inline"/>
                                    <field name="oe_method_period_unit" class="oe_inline" readonly="state != 'draft'"/>
                                </div>
                                <field name="method_end" readonly="state != 'draft'" required="method_time == 'end'" invisible="method_time == 'number'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>