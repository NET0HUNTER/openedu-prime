<list edit="false" sample="1" decoration-info="state == 'draft'" decoration-muted="state == 'canceled'">
                    <header>
                        <button name="action_post" type="object" string="Confirm"/>
                    <button name="663" type="action" string="Create Batch"/>
                    </header>
                    <field name="company_currency_id" column_invisible="True" on_change="1"/>
                    <!-- <field name="suitable_journal_ids" column_invisible="True"/> -->
                    <field name="available_payment_method_line_ids" column_invisible="True" on_change="1"/>
                    <field name="date" readonly="state in ['cancel', 'in_process']" on_change="1"/>
                    <field name="name"/>
                    <field name="journal_id" optional="hide" on_change="1"/>
                    <field name="company_id" optional="hide" on_change="1"/>
                    <field name="payment_method_line_id" context="{'hide_payment_journal_id': 1}" optional="hide" on_change="1"/>
                    <field name="partner_id" string="Partner" on_change="1"/>
                <field name="batch_payment_id" optional="hide"/>
                    <field name="amount_signed" string="Amount in Currency" optional="hide"/>
                    
                    <field name="currency_id" string="Payment Currency" optional="hide" on_change="1"/>
                    <field name="activity_ids" widget="list_activity" optional="hide"/>
                    <field name="amount_company_currency_signed" widget="monetary" string="Amount" sum="Total"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_process'" decoration-success="state == 'paid'" on_change="1"/>
                </list>