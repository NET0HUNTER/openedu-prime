<form string="Facility Allocation">
                <header>
                    <button name="1175" type="action" string="Create Invoice" invisible="invoice_id != False" context="{'default_partner_id': partner_id,'default_product_id': product_id,'default_from_date': from_date,'default_to_date': to_date}" class="oe_highlight"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                    <h1>
                        <field name="partner_id" placeholder="Person" can_create="True" can_write="True"/>
                    </h1>
                    <group class="pt-4">
                        <group>
                            <field name="facility_id" required="1" options="{'no_create_edit': True, 'no_create': True}" can_create="True" can_write="True"/>
                            <field name="from_date" required="1"/>
                            <field name="invoice_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="product_id" required="1" can_create="True" can_write="True"/>
                            <field name="to_date" required="1"/>
                            <field name="company_id" optional="show" can_create="True" can_write="True"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>