<form string="Session">
                    <header>
                        <button type="object" name="lecture_confirm" invisible="state != 'draft'" string="Confirm" class="oe_highlight"/>
                        <button type="object" name="lecture_done" invisible="state != 'confirm'" string="Done" class="oe_highlight"/>
                        <button type="object" name="lecture_draft" invisible="state not in ('confirm', 'cancel')" string="Reset to Draft"/>
                        <button type="object" name="lecture_cancel" invisible="state not in ('confirm','done')" string="Cancel"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
               <button class="btn oe_stat_button" type="object" name="get_attendance" string="Attendance Sheet" style="border-right: 1px solid;" icon="fa-book"/>
                <button class="btn oe_stat_button" type="object" name="action_view_online_meetings" style="border-right: 1px solid;" icon="fa-pencil-square-o">
                    <field string="Online Meetings" name="meeting_count" widget="statinfo"/>
                </button>
                        </div>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="faculty_id" options="{&quot;no_open&quot;: True}" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                                <field name="course_id" options="{&quot;no_open&quot;: True}" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                                <field name="subject_id" readonly="state != 'draft'" domain="[('course_id', '=', course_id)]" on_change="1" can_create="True" can_write="True"/>
                                <field name="type" readonly="state != 'draft'"/>
                <field name="lesson_ids" widget="many2many_tags"/>
                <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="batch_id" options="{&quot;no_open&quot;: True}" context="{'course_id': course_id,'get_parent_batch':1}" readonly="state != 'draft'" on_change="1" can_create="True" can_write="True"/>
                <field name="required_field" invisible="1"/>
                <field name="user_id" invisible="1" on_change="1" can_create="True" can_write="True"/>
                 
                                <field name="classroom_id" readonly="state != 'draft'" can_create="True" can_write="True"/>
                                <label for="start_datetime" string="Session Time"/>
                                <div class="o_row">
                                    <field name="start_datetime" widget="daterange" class="oe_inline" options="{'end_date_field': 'end_datetime'}" readonly="state != 'draft'" on_change="1"/>
                                    <field name="end_datetime" invisible="1" readonly="state != 'draft'" on_change="1"/>
                                </div>
                            </group>
                        </group>
                        <group>
                            <field name="student_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}" domain="[('course_detail_ids.batch_id', '=', batch_id)]" readonly="state != 'draft'" can_create="True" can_write="True"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
