<search>
                <field name="faculty_id"/>
                <field name="course_id"/>
                <field name="batch_id"/>
                <field name="subject_id"/>
                <filter string="Today" name="filter_lesson_today" domain="[('start_datetime', '&gt;=', time.strftime('%Y-%m-%d 00:00:00')),('start_datetime', '&lt;=', time.strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Week" name="filter_lesson_week" domain="[('start_datetime','&gt;=',(context_today()+relativedelta(weeks=-1,days=1,weekday=0)).strftime('%Y-%m-%d')),                                     ('start_datetime','&lt;',(context_today()+relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"/>
                <filter string="Month" name="filter_lesson_month" domain="[('start_datetime','&lt;=',(datetime.date.today()+relativedelta(day=31)).strftime('%Y-%m-%d')),                                     ('start_datetime','&gt;=',(datetime.date.today()-relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="faculty_id" string="Faculty" domain="[]" context="{'group_by':'faculty_id'}"/>
                    <filter name="course_id" string="Course" domain="[]" context="{'group_by':'course_id'}"/>
                    <filter name="batch_id" string="Batch" domain="[]" context="{'group_by':'batch_id'}"/>
                    <filter name="subject_id" string="Subjects" domain="[]" context="{'group_by':'subject_id'}"/>
                </group>
            </search>
