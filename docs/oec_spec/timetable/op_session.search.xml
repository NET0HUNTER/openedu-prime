<search string="Sessions">
                    <field name="faculty_id" select="True"/>
                    <field name="course_id" select="True"/>
                    <field name="batch_id" select="True"/>
                    <field name="subject_id" select="True"/>
                    <field name="start_datetime" select="True"/>
                    <field name="end_datetime" select="True"/>
                    <field name="type" select="True"/>
                    <newline/>
                    <filter string="Today" name="filter_session_today" domain="[('start_datetime', '&gt;=', time.strftime('%Y-%m-%d 00:00:00')),('start_datetime', '&lt;=', time.strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="Week" name="filter_session_week" domain="[('start_datetime', '&gt;=', (context_today()+relativedelta(weeks=-2,days=1,weekday=0)).strftime('%Y-%m-%d')),                                     ('start_datetime', '&lt;', (context_today()+relativedelta(weekday=6)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Month" name="filter_session_month" domain="[('start_datetime', '&lt;=', (datetime.date.today()+relativedelta(day=31)).strftime('%Y-%m-%d')),                                     ('start_datetime', '&gt;=', (datetime.date.today()-relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <group>
                        <filter string="Faculty" name="group_by_session_faculty_id" domain="[]" context="{'group_by':'faculty_id'}"/>
                        <filter string="Course" name="group_by_session_course_id" domain="[]" context="{'group_by':'course_id'}"/>
                        <filter string="Batch" name="group_by_session_batch_id" domain="[]" context="{'group_by':'batch_id'}"/>
                        <filter string="Subject" name="group_by_session_subject_id" domain="[]" context="{'group_by':'subject_id'}"/>
                        <filter string="State" name="group_by_session_state" domain="[]" context="{'group_by':'state'}"/>
                    </group>
                <searchpanel>
                    <field name="faculty_id" icon="fa fa-users"/>
                    <field name="subject_id" icon="fa fa-book"/>
                </searchpanel>
                </search>
