<form string="Vehicle">
                    <header/>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <group>
                            <group>
                                <field name="model_id" on_change="1" can_create="True" can_write="True"/>
                                <field name="capacity"/>
                                <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="license_plate" on_change="1"/>
                                <field name="driver_id" on_change="1" can_create="True" can_write="True"/>
                            </group>
                        </group>
                        <group>
                            <!--                            <field name="log_fuel" nolabel="1"/>-->
                        </group>
                    </sheet>
                </form>