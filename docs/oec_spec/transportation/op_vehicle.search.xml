<search string="Vehicle">
                    <field name="name"/>
                    <field name="license_plate"/>
                    <field name="capacity"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <newline/>
                    <group>
                        <filter string="Name" name="group_by_vehicle_name" domain="[]" context="{'group_by':'name'}"/>
                        <filter string="Capacity" name="group_by_vehicle_capacity" domain="[]" context="{'group_by':'capacity'}"/>
                    </group>
                    <searchpanel>
                        <field name="model_id" icon="fa fa-bus"/>
                    </searchpanel>

                </search>