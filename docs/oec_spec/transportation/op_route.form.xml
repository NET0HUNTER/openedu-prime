<form string="Routes">
                    <header/>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="product_id" can_create="True" can_write="True"/>
                                <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="vehicle_id" can_create="True" can_write="True"/>
                                <field name="cost"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Stop(s)">
                                <field name="stop_ids" nolabel="1">
                                    <list>
                                        <field name="sequence"/>
                                        <field name="name"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>