<search string="Routes">
                    <field name="name"/>
                    <field name="stop_ids"/>
                    <field name="vehicle_id"/>
                    <field name="cost"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <newline/>
                    <group>
                        <filter string="Vehicle" name="group_by_route_vehicle_id" domain="[]" context="{'group_by':'vehicle_id'}"/>
                    </group>
                </search>