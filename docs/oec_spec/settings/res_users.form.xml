<form string="Users">
                    <sheet>
                        <div class="d-flex gap-3">
                            <field name="image_1920" widget="contact_image" options="{'preview_image': 'avatar_128', 'zoom': true, 'size': [130,130], 'img_class': 'rounded-4'}" on_change="1"/>
                            <field name="avatar_128" invisible="1" on_change="1"/> <!-- Needed in contact_image widget -->
                            <div class="d-flex flex-column flex-grow-1 justify-content-center">
                                <h1 class="mb-0 w-100">
                                    <field name="name" placeholder="e.g. John Doe" required="1" on_change="1"/>
                                </h1>
                                <div class="d-flex align-items-baseline w-100">
                                    <field name="email" invisible="1" on_change="1"/> <!-- needed to update partner's email from on_change_login() -->
                                    <i class="fa fa-fw me-1 fa-envelope text-primary" title="Email"/>
                                    <field name="email_domain_placeholder" invisible="1"/> <!-- needed to compute the placeholder whenever the dialog opens -->
                                    <field name="login" class="w-100" options="{'placeholder_field': 'email_domain_placeholder'}" on_change="1"/>
                                </div>
                                <div class="d-flex align-items-baseline w-100">
                                    <i class="fa fa-fw me-1 fa-phone text-primary" title="Phone"/>
                                    <field name="phone" class="w-100" widget="phone" placeholder="Phone" on_change="1"/>
                                </div>
                                <div class="d-flex align-items-baseline w-100">
                                    <i class="fa fa-fw me-1 fa-building text-primary" title="Company"/>
                                    <field name="company_id" class="w-100" context="{'user_preference': 0}" placeholder="Company" can_create="True" can_write="True"/>
                                </div>
                            </div>
                        </div>
                        <group name="access_groups" invisible="id &gt; 0">
                            <label for="group_ids" string="Access Rights" invisible="1" column_invisible="1"/>
                            <div invisible="1" column_invisible="1">
                                <field name="group_ids" readonly="1" widget="many2many_tags" style="display: inline;" on_change="1"/> You will be able to define additional access rights by editing the newly created user under the Settings / Users menu.
                            </div>
                    <field name="create_employee_id" force_save="1" invisible="1" can_create="True" can_write="True"/>
                    <field name="create_employee" force_save="1" string="Create Employee" invisible="1"/>
                    <!-- It is required to stay create_employee field defined here to make it true because store value is false -->
                        </group>
                    <group name="Warehouses">
                        
                    </group>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_employees" class="oe_stat_button" icon="fa-users" invisible="employee_count == 0" context="{'active_test': False}" type="object">
                            <field name="employee_count" widget="statinfo" string="Employee"/>
                        </button>
                    </div>
                    </sheet>
                </form>