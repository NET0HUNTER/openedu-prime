<list>
                    <field name="name" optional="hide"/>
                    <field name="student_id"/>
                    <field name="activity_lines" string="Activity"/>
                    <field name="achievement_lines" string="Achievement"/>
                    <field name="assignment_lines" string="Assignment"/>
                    <field name="attendance_lines" string="Attendance"/>
                    <field name="discipline_lines" string="Discipline"/>
                    <field name="marksheet_lines" string="Marksheet Lines" on_change="1"/>
                    <field name="total_marksheet_line" optional="hide"/>
                    <field name="date"/>
                    <field name="created_by"/>
                    <field name="state" string="Status" widget="badge" decoration-muted="state in ('draft')" decoration-success="state in ('done')" decoration-primary="state in ('open')" decoration-danger="state in ('cancel')" optional="show"/>
                    <field name="active" widget="boolean_toggle" optional="hide"/>
                    <field name="company_id" optional="show"/>
                </list>
