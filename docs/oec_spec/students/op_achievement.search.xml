<search string="Achievement">
                    <field name="student_id"/>
                    <field name="faculty_id"/>
                    <field name="achievement_type_id"/>
                    <field name="description"/>
                    <field name="achievement_date"/>
                    <newline/>
                    <group>
                        <filter string="Student" name="group_by_achievement_student" domain="[]" context="{'group_by':'student_id'}"/>
                        <filter string="Faculty" name="group_by_achievement_faculty" domain="[]" context="{'group_by':'faculty_id'}"/>
                        <filter string="Achievement Type" name="group_by_achievement_type_id" domain="[]" context="{'group_by':'achievement_type_id'}"/>
                        <filter string="Description" name="group_by_achievement_description" domain="[]" context="{'group_by':'description'}"/>
                        <filter string="Date" name="group_by_achievement_date" domain="[]" context="{'group_by':'achievement_date'}"/>
                        <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    </group>
                </search>
