<form string="Event Category">
                    <sheet>
                        <div class="oe_title">
                            <h1><field nolabel="1" name="name" placeholder="e.g. &quot;Age Category&quot;"/></h1>
                        </div>
                        <group>
                <field name="is_published" string="Show on Website" widget="boolean_toggle"/>
                <field name="website_id" string="Website" invisible="not is_published" can_create="True" can_write="True"/>
                            <field name="tag_ids" context="{'default_category_id': id}">
                                <list string="Tags" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" placeholder="e.g. &quot;12-16 years old&quot;"/>
                                    <field name="color" widget="color_picker"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>