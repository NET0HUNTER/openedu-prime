<form string="Lead Generation Rule">
                <header>
                    <button class="btn btn-primary" name="action_execute_rule" type="object" string="Execute Rule" help="Execute this rule for all ongoing and future events."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. B2B Fairs"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="company_id" invisible="1" can_create="True" can_write="True"/>
                    <group name="lead_creation_configuration">
                        <group name="lead_creation_basis" invisible="0">
                            <field name="lead_creation_basis" widget="radio"/>
                        </group>
                        <group>
                            <field name="lead_creation_trigger" widget="radio"/>
                        </group>
                    </group>
                    <group string="For any of these Events">
                        <group>
                            <field name="event_type_ids" widget="many2many_tags" placeholder="All Event templates" can_create="True" can_write="True"/>
                            <field name="company_id" options="{'no_create': True}" placeholder="Visible to all" can_create="True" can_write="True"/>
                        </group>
                        <group>
                            <field name="event_id" options="{'no_create': True}" placeholder="All Events" can_create="True" can_write="True"/>
                        </group>
                    </group>
                    <group string="If the Attendees meet these Conditions">
                        <field name="event_registration_filter" widget="domain" options="{'foldable': True, 'model': 'event.registration'}" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Lead Default Values">
                        <group class="col">
                            
                            <field name="lead_sales_team_id" on_change="1" can_create="True" can_write="True"/>
                            <field name="lead_user_id" widget="many2one_avatar_leader_user" teamField="lead_sales_team_id" can_create="True" can_write="True"/>
                        </group>
                        <group class="col">
                            <field name="lead_tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" can_create="True" can_write="True"/>
                        </group>
                    </group>
                </sheet>
            </form>