<form string="Programs">
                    <header/>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                        </div>
                        <field name="active" invisible="True"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                                <div class="d-flex justify-content-between">
                                <div class="row oe_title">
                                    <label for="name" string="Program Title"/>
                                    <h1>
                                        <field name="name" options="{'line_breaks': False}" widget="text" default_focus="1" placeholder="e.g. &quot;MBA&quot;"/>
                                    </h1>
                                </div>
                                <field name="image_1920" widget="image" class="oe_left oe_avatar"/>
                        </div>
                        <group class="pt-3">
                            <group name="main">
                                <field name="code"/>
                                <field name="min_unit_load"/>
                    <field name="area_id" required="True" can_create="True" can_write="True"/>
                                <field name="program_level_id" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="department_id" can_create="True" can_write="True"/>
                                <field name="max_unit_load"/>
                    <field name="company_id" can_create="True" can_write="True"/>
                    <field name="required_thesis"/>
                            </group>
                        </group>
                <group>
                    <field name="short_desc" required="True"/>
                    <field name="full_description"/>
                </group>
                    <notebook>
                        <page name="thesis_config" string="Thesis Configuration" invisible="not required_thesis">
                            <group>
                                <group>
                                    <field name="thesis_duration"/>
                                </group>
                                <group>
                                    <field name="evaluation_template_id" on_change="1" can_create="True" can_write="True"/>
                                </group>
                            </group>
                            <group>
                                <field name="thesis_guidelines" widget="html"/>
                            </group>
                        </page>
                    </notebook>
                    </sheet>
                    <chatter/>
                </form>
