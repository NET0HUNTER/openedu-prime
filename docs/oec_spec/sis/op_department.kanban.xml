<kanban highlight_color="color" string="Department kanban" class="o_slide_kanban o_slide_channel_kanban" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <templates>
                    <t t-name="menu">
                        <div class="container" role="menu">
                        <div class="row my-2">
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_view">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_views" class="o_kanban_card_manage_title">
                                            <span>Views</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_new">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_new" class="o_kanban_card_manage_title">
                                            <span>New</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-4 o_kanban_card_manage_section o_kanban_manage_operations">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_reports" class="o_kanban_card_manage_title">
                                            <span>Reports</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div t-if="widget.editable" class="o_kanban_card_manage_settings row">
                                <div role="menuitem" aria-haspopup="true" class="col-8">
                                    <field name="color" widget="kanban_color_picker"/>
                                </div>
                                <div role="menuitem" class="col-4">
                                    <a type="open">Settings</a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <main class="d-flex flex-column gap-2 p-1">
                            <!-- Card Header -->
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="flex-grow-1" style="min-width: 0;">
                                    <h5 class="mb-0 fw-bold text-primary text-truncate" t-att-title="record.name.value" style="font-size: 1.15rem;">
                                        <field name="name"/>
                                    </h5>
                                </div>
                            </div>

                            <!-- Metrics Grid (3 rows, 2 columns) -->
                            <div class="row g-2 mt-1">
                                <!-- Programs -->
                                <div class="col-6">
                                    <a name="1107" type="action" class="d-flex align-items-center justify-content-between text-decoration-none bg-light p-2 rounded h-100 border border-light-subtle" style="background-color: #f8f9fa !important; min-width: 0;">
                                        <span class="d-flex align-items-center text-muted small" style="min-width: 0;">
                                            <i class="fa fa-graduation-cap me-2 text-dark flex-shrink-0" title="Programs"/>
                                            <span class="text-truncate"><t t-esc="program_label_plural"/></span>
                                        </span>
                                        <span class="badge rounded-pill bg-dark-subtle text-dark fw-bold fs-6 flex-shrink-0 ms-2">
                                            <field name="program_count"/>
                                        </span>
                                    </a>
                                </div>

                                <!-- Courses -->
                                <div class="col-6">
                                    <a name="1106" type="action" class="d-flex align-items-center justify-content-between text-decoration-none bg-light p-2 rounded h-100 border border-light-subtle" style="background-color: #f8f9fa !important; min-width: 0;">
                                        <span class="d-flex align-items-center text-muted small" style="min-width: 0;">
                                            <i class="fa fa-book me-2 text-dark flex-shrink-0" title="Courses"/>
                                            <span class="text-truncate"><t t-esc="course_label_plural"/></span>
                                        </span>
                                        <span class="badge rounded-pill bg-dark-subtle text-dark fw-bold fs-6 flex-shrink-0 ms-2">
                                            <field name="course_count"/>
                                        </span>
                                    </a>
                                </div>

                                <!-- Faculty -->
                                <div class="col-6">
                                    <a name="1111" type="action" class="d-flex align-items-center justify-content-between text-decoration-none bg-light p-2 rounded h-100 border border-light-subtle" style="background-color: #f8f9fa !important; min-width: 0;">
                                        <span class="d-flex align-items-center text-muted small" style="min-width: 0;">
                                            <i class="fa fa-users me-2 text-dark flex-shrink-0" title="Faculty"/>
                                            <span class="text-truncate"><t t-esc="faculty_label_plural"/></span>
                                        </span>
                                        <span class="badge rounded-pill bg-dark-subtle text-dark fw-bold fs-6 flex-shrink-0 ms-2">
                                            <field name="faculty_count"/>
                                        </span>
                                    </a>
                                </div>

                                <!-- Students -->
                                <div class="col-6">
                                    <a name="1110" type="action" class="d-flex align-items-center justify-content-between text-decoration-none bg-light p-2 rounded h-100 border border-light-subtle" style="background-color: #f8f9fa !important; min-width: 0;">
                                        <span class="d-flex align-items-center text-muted small" style="min-width: 0;">
                                            <i class="fa fa-user me-2 text-dark flex-shrink-0" title="Students"/>
                                            <span class="text-truncate"><t t-esc="student_label_plural"/></span>
                                        </span>
                                        <span class="badge rounded-pill bg-dark-subtle text-dark fw-bold fs-6 flex-shrink-0 ms-2">
                                            <field name="student_count"/>
                                        </span>
                                    </a>
                                </div>

                                <!-- Subjects -->
                                <div class="col-6">
                                    <a name="1108" type="action" class="d-flex align-items-center justify-content-between text-decoration-none bg-light p-2 rounded h-100 border border-light-subtle" style="background-color: #f8f9fa !important; min-width: 0;">
                                        <span class="d-flex align-items-center text-muted small" style="min-width: 0;">
                                            <i class="fa fa-bookmark me-2 text-dark flex-shrink-0" title="Subjects"/>
                                            <span class="text-truncate"><t t-esc="subject_label_plural"/></span>
                                        </span>
                                        <span class="badge rounded-pill bg-dark-subtle text-dark fw-bold fs-6 flex-shrink-0 ms-2">
                                            <field name="subject_count"/>
                                        </span>
                                    </a>
                                </div>

                                <!-- Batches -->
                                <div class="col-6">
                                    <a name="1086" type="action" class="d-flex align-items-center justify-content-between text-decoration-none bg-light p-2 rounded h-100 border border-light-subtle" style="background-color: #f8f9fa !important; min-width: 0;">
                                        <span class="d-flex align-items-center text-muted small" style="min-width: 0;">
                                            <i class="fa fa-calendar me-2 text-dark flex-shrink-0" title="Batches"/>
                                            <span class="text-truncate"><t t-esc="batch_label_plural"/></span>
                                        </span>
                                        <span class="badge rounded-pill bg-dark-subtle text-dark fw-bold fs-6 flex-shrink-0 ms-2">
                                            <field name="batch_count"/>
                                        </span>
                                    </a>
                                </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
