<search string="Batch">
                    <field name="code"/>
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="course_id"/>
                    <newline/>
                    <group>
                        <filter name="group_by_batch_start_date" string="Start Date" domain="[]" context="{'group_by':'start_date'}"/>
                        <filter name="group_by_batch_end_date" string="End Date" domain="[]" context="{'group_by':'end_date'}"/>
                        <filter name="group_by_batch_course" string="Course" domain="[]" context="{'group_by':'course_id'}"/>
                        <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    </group>
                </search>
