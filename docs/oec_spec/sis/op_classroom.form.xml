<form string="Classroom">
                    <header/>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="course_id" on_change="1" can_create="True" can_write="True"/>
                                <field name="capacity"/>
                            </group>
                            <group>
                                <field name="code"/>
                                <field name="batch_id" domain="[('course_id','=',course_id)]" can_create="True" can_write="True"/>
                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="facilities" string="Facilities">
                                <field name="facilities" colspan="4" nolabel="1"><list string="Facilities">
                    <field name="facility_id"/>
                    <field name="quantity"/>
                    <field name="company_id" optional="show"/>
                </list></field>
                            </page>
                            <page name="asset_management" string="Asset Management">
                                <field name="asset_line" colspan="4" nolabel="1">
                                    <list editable="bottom">
                                        <field name="product_id" can_create="True" can_write="True"/>
                                        <field name="code"/>
                                        <field name="product_uom_qty"/>
                    <field name="company_id" optional="show" can_create="True" can_write="True"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
