<search string="Facility">
                    <field name="name"/>
                    <field name="code"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <newline/>
                    <group>
                        <filter string="Name" domain="[]" name="group_by_facility_name" context="{'group_by':'name'}"/>
                        <filter string="Code" domain="[]" name="group_by_facility_code" context="{'group_by':'code'}"/>
                    </group>
                </search>
