<form string="Department">
                    <header/>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="parent_id" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="code"/>
                    <field name="company_id" can_create="True" can_write="True"/>
                            </group>
                        </group>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="1106" type="action" icon="fa-book">
                            <field string="Courses" name="course_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="1111" type="action" icon="fa-users">
                            <field string="Faculties" name="faculty_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="1110" type="action" icon="fa-users">
                            <field string="Students" name="student_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="1108" type="action" icon="fa-pencil-square-o">
                            <field string="Subjects" name="subject_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="1086" type="action" icon="fa-book">
                            <field string="Batches" name="batch_count" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" name="1464" type="action" icon="fa-calendar">
                            <field string="TimeTable" name="session_count" widget="statinfo"/>
                        </button>
                    </div>
                    </sheet>
                </form>
