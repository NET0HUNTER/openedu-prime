                    <group>
                        <filter string="Name" name="group_by_schol_name" domain="[]" context="{'group_by':'name'}"/>
                        <filter string="Student" name="group_by_schol_student" domain="[]" context="{'group_by':'student_id'}"/>
                        <filter string="Type" name="group_by_schol_type" domain="[]" context="{'group_by':'type_id'}"/>
                    </group>
                </search>
