<kanban highlight_color="color" string="Batch kanban" class="o_slide_kanban o_slide_channel_kanban" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="color"/>
                <field name="course_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <templates>
                    <t t-name="menu">
                        <div class="container" role="menu">
                        <div class="row my-2">
                                <div class="col-md-4 o_kanban_card_manage_section o_kanban_manage_view">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_views" class="o_kanban_card_manage_title">
                                            <span>Views</span>
                                        </div>
                        <div class="mt-2">
                            <a type="action" class="d-block px-1" name="1433">Attendance Sheet</a>
                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 o_kanban_card_manage_section o_kanban_manage_new">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_new" class="o_kanban_card_manage_title">
                                            <span>New</span>
                                        </div>
                        <div class="mt-2">
                            <a type="object" name="open_generate_timetable" class="d-block px-1">Generate TimeTable</a>
                        </div>
                        <div class="mt-2"><a type="object" name="create_attendance_sheet" class="d-block px-1">Attendance Sheet</a></div>
                                    </div>
                                </div>
                                <div class="col-md-4 o_kanban_card_manage_section o_kanban_manage_operations">
                                    <div role="menuitem" class="px-1">
                                        <div name="openeducat_reports" class="o_kanban_card_manage_title">
                                            <span>Reports</span>
                                        </div>
                        <div class="mt-2">
                            <a type="object" name="open_generate_timetable_reports" class="d-block px-1">TimeTable Report</a>
                        </div>
                                    </div>
                                </div>
                            </div>
                            <div t-if="widget.editable" class="o_kanban_card_manage_settings row">
                                <div role="menuitem" aria-haspopup="true" class="col-8">
                                    <field name="color" widget="kanban_color_picker"/>
                                </div>
                                <div role="menuitem" class="col-4">
                                    <a type="open">Settings</a>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <main class="d-flex flex-column gap-2 p-1">
                            <!-- Card Header -->
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div class="flex-grow-1 d-flex flex-column gap-1" style="min-width: 0;">
                                    <h5 class="mb-0 fw-bold text-primary text-truncate" t-att-title="record.name.value" style="font-size: 1.15rem;">
                                        <field name="name"/>
                                    </h5>
                                </div>
                            </div>

                            <!-- Course -->
                            <div class="d-flex align-items-center small text-muted">
                                <i class="fa fa-book me-2" role="img" aria-label="Course" title="course"/>
                                <field name="course_id"/>
                            </div>

                            <!-- Dates -->
                            <div class="d-flex align-items-center small text-muted">
                                <i class="fa fa-calendar me-2" role="img" aria-label="Dates" title="Dates"/>
                                <field name="start_date" widget="date"/>
                                <span class="mx-2">-</span>
                                <field name="end_date" widget="date"/>
                            </div>

                            <!-- Metrics Grid (2 columns) -->
                            <div class="row g-2 mt-1" name="metrics_grid">
                                <!-- Students -->
                                <div class="col-6" name="student_link">
                                    <a name="1084" type="action" class="d-flex align-items-center justify-content-between text-decoration-none bg-light p-2 rounded h-100 border border-light-subtle" style="background-color: #f8f9fa !important; min-width: 0;">
                                        <span class="d-flex align-items-center text-muted small" style="min-width: 0;">
                                            <i class="fa fa-user me-2 text-dark flex-shrink-0" title="Students"/>
                                            <span class="text-truncate"><t t-esc="student_label_plural"/></span>
                                        </span>
                                        <span class="badge rounded-pill bg-dark-subtle text-dark fw-bold fs-6 flex-shrink-0 ms-2">
                                            <field name="student_count"/>
                                        </span>
                                    </a>
                                </div>
                        <div class="col-6">
                            <a name="1459" type="action" class="d-flex align-items-center justify-content-between text-decoration-none bg-light p-2 rounded h-100 border border-light-subtle" style="background-color: #f8f9fa !important;">
                                <span class="d-flex align-items-center text-muted small text-truncate">
                                    <i class="fa fa-calendar me-2 text-dark"/>
                                    Sessions
                                </span>
                                <span class="badge rounded-pill bg-dark-subtle text-dark fw-bold fs-6 flex-shrink-0">
                                    <field name="lectures_count"/>
                                </span>
                            </a>
                        </div>
                            </div>
                        </main>
                    </t>
                </templates>
            </kanban>
