<list string="Faculty">
                    <field name="title" on_change="1"/>
                    <field name="name" on_change="1"/>
                    <field name="gender" optional="show"/>
                    <field name="phone" optional="show" on_change="1"/>
                    <field name="email" optional="show"/>
                    <field name="blood_group"/>
                    <field name="emergency_contact" optional="hide"/>
                <field name="company_id" optional="hide"/>
                    <field name="main_department_id"/>
                    <field name="allowed_department_ids" widget="many2many_tags"/>
                <field name="designation" column_invisible="1"/>
                    <field name="assignment_count" optional="hide"/>
                </list>
