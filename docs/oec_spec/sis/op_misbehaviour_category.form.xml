<form string="Misbehaviour Category">
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active == True"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="parent_id" can_create="True" can_write="True"/>
                                <field name="company_id" optional="show" can_create="True" can_write="True"/>
                            </group>
                            <group>
                                <field name="misbehaviour_type"/>
                                <field name="misbehaviour_template_id" can_create="True" can_write="True"/>
                            </group>
                        </group>
                    </sheet>
                </form>
