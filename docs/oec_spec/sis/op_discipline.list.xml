<list>
                    <field name="student_id" on_change="1"/>
                    <field name="date"/>
                    <field name="course_id"/>
                    <field name="discipline_master"/>
                    <field name="assigned_faculty_id" optional="show" on_change="1"/>
                    <field name="recipients_ids" widget="many2many_tags"/>
                    <field name="fine_currency_id" column_invisible="1"/>
                    <field name="fine_amount" widget="monetary" options="{'currency_field': 'fine_currency_id'}" optional="hide"/>
                    <field name="state" string="Status" widget="badge" decoration-muted="state == 'draft'" decoration-success="state == 'done'" decoration-danger="state == 'suspended'" decoration-warning="state == 'awaiting_payment'" decoration-primary="state in ('awaiting_letter','awaiting_meeting','email_sent','action_taken')" optional="show"/>
                    <field name="progression_id" optional="hide"/>
                    <field name="priority" widget="priority" optional="hide"/>
                    <field name="misbehaviour_type" optional="hide"/>
                    <field name="merit_points" optional="hide"/>
                    <field name="demerit_points" optional="hide"/>
                    <field name="active" widget="boolean_toggle" optional="hide"/>
                    <field name="company_id" optional="show"/>
                    <button name="send_email" invisible="state != 'draft'" string="Email" icon="fa-envelope" type="object"/>
                </list>
