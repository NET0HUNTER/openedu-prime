<form string="Course Credit">
                <header/>
                <sheet>
                    <group>
                        <group col="4">
                            <field name="course_id" can_create="True" can_write="True"/>
                            <field name="all_academic" widget="radio"/>
                            <field name="academic_year_id" invisible="all_academic == 'general'" required="all_academic != 'general'" can_create="True" can_write="True"/>
                        </group>
                        <group>
                            <field name="course_plan_id" can_create="True" can_write="True"/>
                        </group>
                    </group>
                    <group>
                        <field name="subject_credit" invisible="all_academic != 'general'"><list>
                    <field name="subject_id" on_change="1"/>
                    <field name="credit"/>
                </list></field>
                        <field name="sem_credit_line_id" invisible="all_academic == 'general'">
                            <list>
                                <field name="semester_id"/>
                                <field name="min_credit"/>
                                <field name="max_credit"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
