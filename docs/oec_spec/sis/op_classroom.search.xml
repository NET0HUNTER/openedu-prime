<search string="Classroom">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="capacity"/>
                    <field name="facilities"/>
                    <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    <newline/>
                    <group>
                        <filter string="Name" name="group_by_classroom_name" domain="[]" context="{'group_by':'name'}"/>
                        <filter string="Code" name="group_by_classroom_code" domain="[]" context="{'group_by':'code'}"/>
                        <filter string="Capacity" name="group_by_classroom_capacity" domain="[]" context="{'group_by':'capacity'}"/>
                    </group>
                    <searchpanel>
                        <field name="course_id" icon="fa fa-book"/>
                    </searchpanel>
                </search>
