<kanban class="op_scholarship_kanban" default_group_by="scholarship_stages_id" sample="1">
                    <field name="name"/>
                    <field name="student_id"/>
                    <field name="type_id"/>
                    <field name="amount"/>
                    <field name="course_id" on_change="1"/>
                    <field name="batch_id"/>
                    <field name="scholarship_stages_id"/>
                    <templates>
                        <t t-name="card">
                            <main class="d-flex flex-column gap-2 p-1 w-100">
                                <div class="d-flex justify-content-between align-items-center gap-2">
                                    <h5 class="mb-0 fw-bold text-truncate text-primary" t-att-title="record.name.value" style="font-size: 15px;">
                                        <field name="name"/>
                                    </h5>
                                    <span t-if="record.amount.raw_value" class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small fw-semibold flex-shrink-0">
                                        <i class="fa fa-money me-1" role="img" aria-label="Amount" title="Amount"/>
                                        <t t-esc="record.amount.value"/>
                                    </span>
                                </div>
                                <div class="d-flex flex-column gap-1">
                                    <div t-if="record.student_id.raw_value" class="d-flex align-items-center text-truncate small text-muted">
                                        <i class="fa fa-user me-2 text-muted" style="width: 14px;" role="img" aria-label="Student" title="Student"/>
                                        <span class="text-truncate">
                                            <field name="student_id"/>
                                        </span>
                                    </div>
                                    <div t-if="record.type_id.raw_value" class="d-flex align-items-center text-truncate small text-muted">
                                        <i class="fa fa-tags me-2 text-muted" style="width: 14px;" role="img" aria-label="Type" title="Type"/>
                                        <span class="text-truncate">
                                            <field name="type_id"/>
                                        </span>
                                    </div>
                                    <div t-if="record.course_id.raw_value or record.batch_id.raw_value" class="d-flex align-items-center text-truncate small text-muted">
                                        <i class="fa fa-graduation-cap me-2 text-muted" style="width: 14px;" role="img" aria-label="Course and Batch" title="Course and Batch"/>
                                        <span class="text-truncate">
                                            <t t-if="record.course_id.raw_value"><field name="course_id" on_change="1"/></t>
                                            <t t-if="record.course_id.raw_value and record.batch_id.raw_value"> - </t>
                                            <t t-if="record.batch_id.raw_value"><field name="batch_id"/></t>
                                        </span>
                                    </div>
                                </div>
                            </main>
                        </t>
                    </templates>
                </kanban>
