<form>
                <header>
                    <button string="Draft" name="action_draft_progressbar" type="object" invisible="state != 'cancel'"/>
                    <button string="Confirm" name="action_confirm_progressbar" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button string="Cancel" name="action_cancel_progressbar" type="object" invisible="state not in ['confirm', 'draft']"/>
                    <button string="Done" name="action_done_progressbar" type="object" invisible="state != 'confirm'"/>
                    <field name="state" widget="statusbar"/>
                    <widget name="omr_cam_widget" invisible="state != 'confirm'" style="display: contents;"/>
                </header>
                <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="answersheet_action" type="object" class="oe_stat_button" icon="fa-book">
                                <field name="answersheet_count" widget="statinfo" string="Answer Sheets"/>
                            </button>
                        </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="subject_id" readonly="state != 'draft'"/>
                            <field name="is_student_upload_omr"/>
                        </group>
                        <group>
                            <field name="template_id" options="{'no_open': True,'no_create':True}" readonly="state != 'draft'"/>
                            <field name="answersheet_configuration_id" readonly="state != 'draft'"/>
                            <field name="display_result"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Student Answers Detail">
                            <field name="answer_sheets_line" readonly="state != 'draft'" on_change="1">
                                <list>
                                    <field name="roll_number"/>
                                    <field name="key_type"/>
                                    <field name="right_answer"/>
                                    <field name="wrong_answer"/>
                                    <field name="not_attampted"/>
                                    <field name="score"/>
                                    <field name="student_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>