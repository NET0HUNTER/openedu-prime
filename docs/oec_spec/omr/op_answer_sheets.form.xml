<form>
                <header/>
                <sheet>
                    <group col="4" colspan="4">
                        <field name="student_id" can_create="True" can_write="True"/>
                        <field name="roll_number"/>
                        <field name="omr_exam_id" can_create="True" can_write="True"/>
                    </group>
                    <notebook>
                        <page string="Exam Details">
                            <group>
                                <group>
                                    <field name="key_type"/>
                                    <field name="right_answer"/>
                                    <field name="wrong_answer"/>
                                </group>
                                <group>
                                    <field name="not_attampted"/>
                                    <field name="score"/>
                                    <field name="date_time"/>
                                    <field name="image_id" can_create="True" can_write="True"/>
                                    <!-- <field name="result_json"/> -->
                                </group>
                            </group>
                        </page>
                        <page string="Result">
                            <group>
                                <field name="result_json" nolabel="1" widget="result_widget"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>