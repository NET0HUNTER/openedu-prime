<form string="Sales Team" js_class="crm_team_form" class="o_crm_team_form_view">
                    <field name="use_leads" invisible="1" on_change="1"/>
                    <field name="use_opportunities" invisible="1" on_change="1"/>
                    <header invisible="not use_leads and not use_opportunities or not assignment_enabled">
                        <button name="action_assign_leads" type="object" string="Assign Leads" class="oe_highlight" confirm="This will assign leads to all members. Do you want to proceed?" invisible="not use_leads and not use_opportunities or not assignment_enabled" confirm-label="Assign Leads"/>
                    </header>
                <div class="alert alert-info text-center d-flex flex-wrap justify-content-center gap-1" role="alert" invisible="is_membership_multi or not member_warning">
                    <field name="member_warning" class="w-auto"/>
                    Working in multiple teams?
                    <button name="crm_team_activate_multi_membership" type="button" class="btn btn-link p-0 lh-1">
                        Activate "Multi-team"
                    </button>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" string="Sales Team"/>
                        <h1>
                            <field class="text-break" name="name" placeholder="e.g. North America" on_change="1"/>
                        </h1>
                        <div name="options_active" class="o_row">
                    
                    </div>
                    </div>
                    <group>
                        <group name="left" string="Team Details">
                            <field name="active" invisible="1"/>
                            <field name="sequence" invisible="1" on_change="1"/>
                            <field name="is_membership_multi" invisible="1" on_change="1"/>
                            <field name="user_id" widget="many2one_avatar_user" domain="[('share', '=', False)]" can_create="True" can_write="True"/>
                    <label for="alias_name" string="Email Alias" invisible="not use_leads and not use_opportunities"/>
                    <div name="alias_def" invisible="not use_leads and not use_opportunities">
                        <field name="alias_id" string="Email Alias" class="oe_read_only" required="0" on_change="1" can_create="True" can_write="True"/>
                        <div class="oe_edit_only" name="edit_alias" dir="ltr">
                            <field name="alias_name" placeholder="alias" class="oe_inline" on_change="1"/>@
                            <field name="alias_domain_id" class="oe_inline" placeholder="e.g. mycompany.com" options="{'no_create': True, 'no_open': True}" can_create="True" can_write="True"/>
                        </div>
                    </div>
                    <field name="alias_contact" string="Accept Emails From" invisible="not use_leads and not use_opportunities" on_change="1"/>
                            <field name="company_id" options="{'no_create': True}" placeholder="Visible to all" on_change="1" can_create="True" can_write="True"/>
                <label for="invoiced_target"/>
                <div class="o_row" id="invoiced_target">
                    <field name="invoiced_target" widget="monetary" options="{'currency_field': 'currency_id'}" class="oe_inline"/>
                    <span class="flex-grow-1">/ Month</span>
                </div>
                            <field name="currency_id" invisible="1"/>
                            <field name="member_company_ids" invisible="1"/>
                        </group>
                        <group name="right" string="Assignment Rules" invisible="not assignment_enabled">
                    <field name="assignment_enabled" invisible="1" on_change="1"/>
                    <field name="assignment_auto_enabled" invisible="1"/>
                    <field name="lead_all_assigned_month_exceeded" invisible="1"/>
                    <div colspan="2">
                        <div class="o_crm_lead_all_assigned_month_exceeded" invisible="not lead_all_assigned_month_exceeded"/>
                        <div class="o_crm_lead_month_assignment text-muted" invisible="not assignment_enabled">
                            <i class="fa fa-info-circle me-2" title="Assigned Lead Count"/>
                            <field name="lead_all_assigned_month_count" class="oe_inline"/><span> leads assigned this month
                            on a maximum of </span><field name="assignment_max" class="oe_inline" on_change="1"/>
                        </div>
                    </div>
                    <field name="assignment_domain" widget="domain" string="Domain" options="{'foldable': True, 'model': 'crm.lead', 'in_dialog': True}" invisible="not assignment_enabled"/>
                    <field name="assignment_optout" invisible="not assignment_auto_enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members" name="members_users">
                            <field name="member_ids" mode="kanban" class="w-100" invisible="assignment_enabled" on_change="1" can_create="True" can_write="True">
                                <kanban>
                                    <templates>
                                        <t t-name="card" class="flex-row">
                                            <aside>
                                                <field name="avatar_128" widget="image" class="o_image_64_cover" alt="Avatar" on_change="1"/>
                                            </aside>
                                            <main class="ms-3">
                                                <field name="name" class="fw-bold fs-5" on_change="1"/>
                                                <div class="d-flex align-items-baseline text-break">
                                                    <i class="fa fa-envelope me-1" role="img" aria-label="Email" title="Email"/><field name="email" on_change="1"/>
                                                </div>
                                            </main>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                            <field name="crm_team_member_ids" mode="kanban" class="w-100" invisible="not assignment_enabled" context="{                                     'kanban_view_ref': 'sales_team.crm_team_member_view_kanban_from_team',                                     'form_view_ref': 'sales_team.crm_team_member_view_form_from_team',                                     'list_view_ref': 'sales_team.crm_team_member_view_tree_from_team',                                     'default_crm_team_id': id,                                 }" on_change="1"><kanban quick_create="false" group_create="0" records_draggable="0" sample="1" default_group_by="crm_team_id" class="o_crm_team_member_kanban">
                <field name="active" on_change="1"/>
                <field name="assignment_enabled"/>
                <field name="assignment_optout"/>
                <field name="assignment_max" on_change="1"/>
                <templates>
                    <t t-name="card" class="flex-row mb-3">
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <aside>
                            <field name="user_id" widget="image" options="{'preview_image': 'avatar_128'}" class="o_image_64_cover" alt="Avatar" on_change="1"/>
                        </aside>
                        <main class="ms-3">
                            <field name="user_id" class="fw-bold fs-5" on_change="1"/>
                            <a type="open" class="nav-link p-0"/>
                            <div class="d-flex align-items-baseline text-break">
                                <i class="fa fa-envelope me-1" role="img" aria-label="Email" title="Email"/><field name="email"/>
                            </div>
                        </main>
                <div class="o_member_assignment" invisible="assignment_optout">
                    <field name="lead_month_count" widget="gauge" options="{'max_field': 'assignment_max'}" invisible="assignment_max == 0" on_change="1"/>
                </div>
                    </t>
                </templates>
            </kanban></field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>