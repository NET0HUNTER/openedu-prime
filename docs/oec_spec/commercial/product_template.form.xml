                    </span>
                </div>
                <field name="out_of_stock_message" invisible="not is_storable" placeholder="e.g. 'Will be back soon'"/>
                                </group>
                <group colspan="2" name="product_template_images" string="eCommerce Media" invisible="not sale_ok">
