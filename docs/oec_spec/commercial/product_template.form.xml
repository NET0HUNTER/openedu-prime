                <field name="product_id" optional="hide" readonly="0" column_invisible="context.get('product_template_invisible_variant', False)" domain="[('product_tmpl_id', '=', parent.id)]" options="{'no_create': True, 'no_open': True}" on_change="1" can_create="True" can_write="True"/>
                <field name="product_tmpl_id" string="Product" readonly="1" column_invisible="context.get('visible_product_tmpl_id', True)" on_change="1"/>
