<form string="Products Price List">
                <header>
                    <button name="action_open_pricelist_report" type="object" string="Print"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. USD Retailers"/></h1>
                    </div>
                    <group>
                        <group name="pricelist_settings">
                            
                            <field name="active" invisible="1"/>
                            <field name="company_id" options="{'no_create': True}" placeholder="Visible to all" can_create="True" can_write="True"/>
                        </group>
                        <group>
                            <field name="country_group_ids" widget="many2many_tags" can_create="True" can_write="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="pricelist_rules" string="Sales Prices">
                            <field name="item_ids" nolabel="1" context="{'default_base':'list_price'}">
                                <list string="Pricelist Rules">
                                    <field name="product_tmpl_id" column_invisible="True" on_change="1"/>
                                    <field name="name" string="Apply on"/>
                                    <field name="price" string="Price"/>
                                    <field name="min_quantity" on_change="1"/>
                                    <field name="date_start" on_change="1"/>
                                    <field name="date_end" on_change="1"/>
                                    <field name="base" column_invisible="True" on_change="1"/>
                                    <field name="price_discount" column_invisible="True" on_change="1"/>
                                    <field name="applied_on" column_invisible="True" on_change="1"/>
                                    <field name="compute_price" column_invisible="True" on_change="1"/>
                                </list>
                            </field>
                        </page>
                <page name="pricelist_config" string="Ecommerce">
                    <group name="pricelist_website">
                        <field name="company_id" invisible="1" can_create="True" can_write="True"/>
                        <field name="website_id" options="{'no_create': True}" placeholder="Select a website" can_create="True" can_write="True"/>
                        <field name="selectable"/>
                        <field name="code"/>
                    </group>
                </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>