# SabiEdu Environment Configuration (copy to .env and fill credentials)
PORT=4100
# Optional public/LAN URL override used in email action links (auto-detects host LAN IP if unset)
# APP_URL=http://192.168.1.55:5175

# SMTP Email Relay (leave blank or configure via Settings -> Messaging in the ERP UI)
EMAIL_PROVIDER=simulate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SabiEdu
SMTP_FROM_EMAIL=
